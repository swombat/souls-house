#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative "../config/local_instance"
require "socket"
require "open3"

begin
  config = LocalInstance.current
  abort "bin/instance is for development/test only" unless config.local?
  command = ARGV.shift || "show"
  if %w[setup exec].include?(command)
    expected_ruby = File.read(File.join(config.root, ".ruby-version")).strip
    expected_bun = JSON.parse(File.read(File.join(config.root, "package.json"))).fetch("packageManager").delete_prefix("bun@")
    bun_version, _, bun_status = Open3.capture3("bun", "--version")
    unless RUBY_VERSION == expected_ruby && bun_status.success? && bun_version.strip == expected_bun
      abort "Use Ruby #{expected_ruby} and Bun #{expected_bun}. With mise: review mise.toml, run mise trust && mise install, then mise exec -- bin/instance #{command}."
    end
  end
  case command
  when "show"
    puts JSON.pretty_generate(config.to_h)
    warn "External credentials, bots, webhooks and remote repositories are NOT cloned or isolated."
  when "setup"
    abort "Setup requires development mode" unless config.environment == "development"
    config.configure!
    abort "Primary setup is deliberately excluded; use existing bin/setup intentionally." if config.number.zero?
    credentials_from = nil
    unless ARGV.empty?
      abort "Usage: bin/instance setup [--credentials-from /path/to/primary]" unless ARGV.shift == "--credentials-from" && ARGV.length == 1
      credentials_from = File.realpath(ARGV.shift)
    end
    %w[development test].each do |environment|
      relative = "config/credentials/#{environment}.key"
      destination = File.join(config.root, relative)
      if !File.exist?(destination) && credentials_from
        source = File.join(credentials_from, relative)
        abort "Missing #{source}" unless File.file?(source)
        FileUtils.mkdir_p(File.dirname(destination))
        File.open(destination, File::WRONLY | File::CREAT | File::EXCL, 0o600) { |file| file.write(File.binread(source)) }
      end
      unless File.file?(destination) || ENV["RAILS_MASTER_KEY"]
        abort "Missing #{relative}; provide --credentials-from /path/to/primary (copies development/test keys only)."
      end
    end
    Dir.chdir(config.root) do
      system("bin/bundle", "check") || system("bin/bundle", "install", exception: true)
      system("bun", "install", "--frozen-lockfile", exception: true)
      # db:prepare is non-destructive; fresh secondary databases only, no data copy.
      system("bin/rails", "db:prepare", exception: true)
      system({ "RAILS_ENV" => "test" }, "bin/rails", "db:prepare", exception: true)
    end
    puts "Instance #{config.number} prepared. Run bin/dev in this checkout."
  when "exec"
    role = ARGV.shift
    abort "Usage: bin/instance exec dev|test|command -- command [args]" unless %w[dev test command].include?(role) && ARGV.shift == "--" && !ARGV.empty?
    ENV["RAILS_ENV"] = "test" if role == "test"
    config = LocalInstance.current
    config.configure!
    Dir.chdir(config.root)
    # A checkout lock serialises runners sharing PID files/assets/test databases.
    # Keep the supervisor alive: descendants need not understand inherited locks.
    FileUtils.mkdir_p("tmp/pids")
    File.open("tmp/pids/instance-#{role}.lock", "w") do |lock|
      abort "An instance #{role} command is already running in this checkout" unless lock.flock(File::LOCK_EX | File::LOCK_NB)
      ports = role == "dev" ? [ config.web_port, config.port(:vite) ] : role == "test" ? [ config.port(:backend), config.port(:component) ] : []
      ports.each do |port|
        begin
          TCPServer.new("127.0.0.1", port).close
        rescue Errno::EADDRINUSE
          abort "Port #{port} is occupied; refusing to reuse or stop its owner"
        end
      end
      child = Process.spawn(*ARGV, pgroup: true)
      %w[INT TERM].each do |signal|
        Signal.trap(signal) { Process.kill(signal, -child) rescue Errno::ESRCH }
      end
      Process.wait(child)
      exit($?.exitstatus || 1)
    end
  else
    abort "Usage: bin/instance show|setup|exec"
  end
rescue LocalInstance::Error, Errno::ENOENT => error
  abort error.message
end
