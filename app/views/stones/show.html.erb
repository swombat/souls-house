<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title><%= @revision.title %> · Stone</title>
    <style>
      * { box-sizing: border-box; }
      body { margin: 0; background: #f6f5f2; color: #252422; font: 15px system-ui, sans-serif; }
      header { padding: 16px 24px; display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; border-bottom: 1px solid #ddd9d1; }
      h1 { font-size: 18px; margin: 0 0 4px; overflow-wrap: anywhere; }
      p { margin: 0; color: #68645f; font-size: 13px; }
      a { color: #5b3e91; }
      iframe { display: block; border: 0; background: white; width: 100%; height: calc(100dvh - 100px); min-height: 70vh; }
      nav { display: flex; gap: 14px; font-size: 13px; }
      @media (max-width: 600px) { header { padding: 12px; } h1 { font-size: 16px; } }
    </style>
  </head>
  <body>
    <header>
      <div>
        <h1><%= @revision.title %></h1>
        <p>Public stone · Revision <%= @revision.number %> · <%= @revision.agent&.name || "House member" %></p>
        <p>Authored content, not a house sign-in page. Never enter credentials here.</p>
        <% if @interactive %>
          <p>Interactive JavaScript · Never enter private information. This is not a complete network or resource sandbox.</p>
        <% end %>
      </div>
      <nav aria-label="Stone revisions">
        <% if @latest.number > @revision.number %>
          <%= link_to "Newer revision available (#{@latest.number})", hosted? ? "/" : stone_path(@stone.public_token) %>
        <% end %>
        <%= link_to "Link to this revision", hosted? ? hosted_stone_revision_path(@revision.number) : stone_revision_path(@stone.public_token, @revision.number) %>
      </nav>
    </header>
    <% content_path = hosted? ? hosted_stone_content_path(@revision.number) : stone_revision_content_path(@stone.public_token, @revision.number) %>
    <% if @interactive %>
      <div>
        <button id="stone-stop" type="button">Stop and unload</button>
        <button id="stone-start" type="button" hidden>Run again</button>
        <p id="stone-status" role="status">Running</p>
        <% if @reads_tables %><p id="stone-writes" hidden>Write link · this page can add rows to its tables. Anyone you give this link to can too.</p><% end %>
      </div>
      <div id="stone-container" data-source="<%= content_path %>" data-title="<%= @revision.title %>"<% if @reads_tables %> data-tables="<%= hosted_stone_data_path(@revision.number) %>" data-writes="<%= hosted_stone_rows_path(@revision.number) %>" data-revision="<%= @revision.number %>"<% end %>>
        <% unless @reads_tables %>
        <iframe
        title="<%= @revision.title %>"
        src="<%= content_path %>"
        sandbox="allow-scripts"
        referrerpolicy="no-referrer"
        allow="camera 'none'; microphone 'none'; geolocation 'none'"></iframe>
        <% end %>
      </div>
      <script nonce="<%= @viewer_nonce %>">
        (() => {
          const container = document.getElementById("stone-container");
          const start = document.getElementById("stone-start");
          const stop = document.getElementById("stone-stop");
          const status = document.getElementById("stone-status");
          const mount = () => {
            if (dataPath) unbind();
            const frame = document.createElement("iframe");
            frame.title = container.dataset.title;
            frame.setAttribute("sandbox", "allow-scripts");
            frame.setAttribute("allow", "camera 'none'; microphone 'none'; geolocation 'none'");
            frame.referrerPolicy = "no-referrer";
            frame.src = container.dataset.source;
            if (dataPath) {
              // A fresh token per mount, in the frame's own URL: only the
              // document served for this mount and revision carries it.
              const bytes = crypto.getRandomValues(new Uint8Array(24));
              const token = btoa(String.fromCharCode(...bytes)).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "");
              frame.dataset.k = token;
              frame.src = container.dataset.source + "?k=" + token;
              watch(frame);
            }
            container.replaceChildren(frame);
            start.hidden = true;
            stop.hidden = false;
            status.textContent = "Running";
          };
          start.addEventListener("click", mount);
          // Field tables (when this revision reads any). The frame's first
          // script opens a MessageChannel and sends one port with the token
          // this mount put in its URL and the revision it was served as. The
          // viewer binds that port once per mount and talks only over it:
          // refresh asks arrive on it, rows go back on it, never to a
          // WindowProxy. A document the frame navigates to has no port, so an
          // in-flight refresh can't reach it. Loads are counted as a second
          // check. At most one fetch per 10 s; asks in between fold into one.
          const dataPath = container.dataset.tables;
          const writePath = container.dataset.writes;
          // The write link carries its key in the fragment (#w=...), which the
          // browser never sends to a server. Only this script holds it; the
          // frame asks over its port and never sees the key.
          const writeKey = (() => {
            const match = /(?:^#|&)w=([A-Za-z0-9_-]{20,128})(?:&|$)/.exec(location.hash);
            return match ? match[1] : null;
          })();
          let writesInFlight = 0;
          if (writeKey && writePath) document.getElementById("stone-writes").hidden = false;
          const MIN_GAP = 10000;
          const revision = Number(container.dataset.revision);
          let lastFetch = 0, pending = null, port = null;
          const watch = (frame) => {
            frame.dataset.loads = "0";
            frame.addEventListener("load", () => { frame.dataset.loads = String(Number(frame.dataset.loads) + 1); });
          };
          const live = (frame) => frame && frame.isConnected && Number(frame.dataset.loads || 0) <= 1;
          const unbind = () => {
            if (port) port.close();
            port = null;
            if (pending) clearTimeout(pending);
            pending = null;
          };
          const send = async (frame, bound) => {
            pending = null;
            lastFetch = Date.now();
            try {
              const response = await fetch(dataPath, { credentials: "omit", cache: "no-store" });
              if (!response.ok) return;
              const body = await response.json();
              if (bound === port && live(frame)) bound.postMessage({ souls_field: 1, type: "tables", tables: body.tables });
            } catch (error) { /* the frame keeps its last rows */ }
          };
          const schedule = (frame, bound) => {
            if (pending) return;
            const wait = Math.max(0, lastFetch + MIN_GAP - Date.now());
            pending = setTimeout(() => send(frame, bound), wait);
          };
          const write = async (frame, bound, ask) => {
            const answer = (reply) => {
              if (bound === port && live(frame)) bound.postMessage({ souls_field: 1, type: "written", id: ask.id, ...reply });
            };
            if (!writeKey || !writePath) return answer({ ok: false, error: "This link can't write to tables; open the stone's write link" });
            if (writesInFlight >= 4) return answer({ ok: false, error: "Too many writes at once; wait for the last ones" });
            writesInFlight += 1;
            try {
              const response = await fetch(writePath, {
                method: "POST", credentials: "omit", cache: "no-store",
                headers: { "Content-Type": "application/json", "X-Stone-Write-Key": writeKey },
                body: JSON.stringify({ table: ask.table, row: ask.row })
              });
              const body = await response.json().catch(() => ({}));
              if (response.ok) {
                answer({ ok: true, row: body.row });
                if (bound === port && live(frame)) schedule(frame, bound);
              } else {
                answer({ ok: false, error: typeof body.error === "string" ? body.error : "The house refused the row (" + response.status + ")" });
              }
            } catch (error) {
              answer({ ok: false, error: "Couldn't reach the house; the row was not confirmed" });
            } finally {
              writesInFlight -= 1;
            }
          };
          if (dataPath) {
            window.addEventListener("message", (event) => {
              const frame = container.querySelector("iframe");
              if (port || !live(frame) || event.source !== frame.contentWindow) return;
              const data = event.data;
              if (!data || data.souls_field !== 1 || data.type !== "hello") return;
              if (data.k !== frame.dataset.k || data.revision !== revision || event.ports.length !== 1) return;
              const bound = event.ports[0];
              port = bound;
              bound.onmessage = (message) => {
                const ask = message.data;
                if (bound !== port || !ask || ask.souls_field !== 1) return;
                if (ask.type === "write") {
                  if (Number.isInteger(ask.id) && typeof ask.table === "string") write(frame, bound, ask);
                  return;
                }
                if (ask.type === "refresh") schedule(frame, bound);
              };
              bound.postMessage({ souls_field: 1, type: "ready", can_write: Boolean(writeKey && writePath) });
            });
            // Made here rather than in the markup, so its first load is
            // always counted and a later navigation is always noticed.
            mount();
          }
          stop.addEventListener("click", () => {
            if (dataPath) unbind();
            container.replaceChildren();
            start.hidden = false;
            stop.hidden = true;
            status.textContent = "Stopped and unloaded";
          });
        })();
      </script>
    <% else %>
      <iframe
      title="<%= @revision.title %>"
      src="<%= content_path %>"
      sandbox=""
      referrerpolicy="no-referrer"
      allow="camera 'none'; microphone 'none'; geolocation 'none'"></iframe>
    <% end %>
  </body>
</html>
