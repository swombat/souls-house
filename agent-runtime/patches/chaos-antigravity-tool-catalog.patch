+pub(crate) fn antigravity_system_prompt(prompt: &crate::client_common::Prompt) -> String {
+    // Reuse the bridge projection, including its freeform input envelope and
+    // exclusion of provider-native tools. Never copy the CLI's system prompt.
+    let tools: Vec<McpTool> = prompt.tools.iter().cloned().filter_map(tool_spec_to_mcp_tool).collect();
+    chaos_clamp::antigravity_system_prompt(&prompt.base_instructions.text, &serde_json::json!(tools))
+}
