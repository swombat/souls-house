     assert_eq!(store.load("gemini-3.1-pro-low"), None);
     store.clear();
 }
+
+
+#[test]
+fn canonical_tool_catalogue_preserves_base_and_refreshes_tools() {
+    let tools = serde_json::json!([{
+        "name": "exec_command",
+        "description": "Run a shell command",
+        "inputSchema": {"type": "object", "properties": {"cmd": {"type": "string"}}, "required": ["cmd"]}
+    }]);
+    let rendered = super::antigravity_system_prompt("Canonical instructions", &tools);
+    assert!(rendered.starts_with("Canonical instructions\n\n"));
+    assert!(rendered.contains("call_mcp_tool"));
+    assert!(rendered.contains("ServerName \"chaos\""));
+    assert!(rendered.ends_with(&tools.to_string()));
+    let empty = super::antigravity_system_prompt("Updated instructions", &serde_json::json!([]));
+    assert!(empty.starts_with("Updated instructions\n\n"));
+    assert!(!empty.contains("exec_command"));
+    assert!(empty.ends_with("[]"));
+}
