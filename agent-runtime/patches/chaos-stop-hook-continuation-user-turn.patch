+pub(crate) fn stop_hook_continuation_message(prompt: String) -> ResponseItem {
+    // A blocking Stop hook requests another conversational turn. Record its
+    // continuation as user input so providers do not receive a request ending
+    // with the assistant message that caused the hook to run.
+    ResponseItem::Message {
+        id: None,
+        role: "user".to_string(),
+        content: vec![ContentItem::InputText { text: prompt }],
+        end_turn: None,
+        phase: None,
+    }
+}
