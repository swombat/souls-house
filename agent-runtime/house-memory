#!/usr/bin/env python3
import importlib.util
from pathlib import Path

path = Path(__file__).with_name("memory_client.py")
if not path.is_file():
    path = Path("/home/agent/memory_client.py")
spec = importlib.util.spec_from_file_location("house_memory", path)
module = importlib.util.module_from_spec(spec)
spec.loader.exec_module(module)
raise SystemExit(module.main())
