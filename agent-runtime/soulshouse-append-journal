#!/bin/sh
set -eu

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
  cat <<'HELP'
Usage: soulshouse-append-journal [TITLE]

Append stdin as a new entry in today's hosted-agent daily journal.
Empty or whitespace-only stdin is rejected without changing the journal.

`helixkit-append-journal` is a permanent alias for this command.

Full souls.house manual: /usr/local/share/helixkit-agent/soulshouse-api.md
HELP
  exit 0
fi

IDENTITY_PATH="${AGENT_IDENTITY_PATH:-/home/agent/identity}"
JOURNAL_DIR="$IDENTITY_PATH/memory/daily-journals"
TODAY="$(date +%Y-%m-%d)"
NOW="$(date +%H:%M)"
TITLE="${1:-Journal entry}"
FILE="$JOURNAL_DIR/$TODAY.md"

BODY="$(cat)"
if [ -z "$(printf '%s' "$BODY" | tr -d '[:space:]')" ]; then
  printf '%s\n' "soulshouse-append-journal: empty body on stdin; nothing written" >&2
  exit 1
fi

mkdir -p "$JOURNAL_DIR"
if [ ! -f "$FILE" ]; then
  printf '# Daily Journal: %s\n' "$TODAY" > "$FILE"
fi

{
  printf '\n## %s — %s\n\n' "$NOW" "$TITLE"
  printf '%s\n' "$BODY"
} >> "$FILE"

printf '%s\n' "$FILE"
