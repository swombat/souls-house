#!/usr/bin/env python3
"""
Use Google Colab with a short-lived Souls Google Workspace service-connection token.

Usage:
  soulshouse-colab [--connection svc_123] check
  soulshouse-colab [--connection svc_123] ccu-info
  soulshouse-colab [--connection svc_123] exec -- <command> [args...]

The Google refresh token and OAuth client secret remain in Souls. This helper
requests only a short-lived access token from the Souls refresh broker, never
prints or persists it, and passes it to child commands via
GOOGLE_COLAB_ACCESS_TOKEN.
"""

import io
import json
import os
from pathlib import Path
import sys
import urllib.error
import urllib.parse
import urllib.request

import yaml

COLABORATORY_SCOPE = "https://www.googleapis.com/auth/colaboratory"
TOKENINFO_URL = "https://oauth2.googleapis.com/tokeninfo"
COLAB_ORIGIN = "https://colab.research.google.com"
COLAB_PUBLIC_API_ORIGIN = "https://colaboratory.googleapis.com"
COLAB_PA_ORIGIN = "https://colab.pa.googleapis.com"
XSSI_PREFIX = ")]}'\n"


class RedirectRefusedError(urllib.error.HTTPError):
    """Raised when RefuseRedirects blocks a redirect carrying a credential."""


class RefuseRedirects(urllib.request.HTTPRedirectHandler):
    """Never follow a redirect: requests carry house or Google credentials, and
    urllib would re-send Authorization headers to whatever origin Location names."""

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        target = urllib.parse.urlsplit(newurl).netloc or newurl
        message = (
            f"refused to follow a redirect ({code}) to {target} with a credential; "
            "check SOULSHOUSE_APP_URL"
        )
        raise RedirectRefusedError(
            req.full_url, code, message, headers, io.BytesIO(message.encode())
        )


NO_REDIRECT_OPENER = urllib.request.build_opener(RefuseRedirects)


def main() -> int:
    try:
        connection_id, args = parse_args(sys.argv[1:])
    except SystemExit as exc:
        if isinstance(exc.code, str):
            print(exc.code, file=sys.stderr)
            return 64
        raise

    if not args:
        print(__doc__.strip())
        return 64
    if args[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0

    command = args[0]
    rest = args[1:]
    if command not in ("check", "ccu-info", "status", "exec"):
        print(f"unknown subcommand: {command}\n\n{__doc__.strip()}", file=sys.stderr)
        return 64

    if command == "exec":
        if rest and rest[0] == "--":
            rest = rest[1:]
        if not rest:
            print("exec requires a command to run", file=sys.stderr)
            return 64
    elif rest:
        print(f"{command} does not accept extra arguments", file=sys.stderr)
        return 64

    bearer_token = (
        os.environ.get("SOULSHOUSE_BEARER_TOKEN")
        or os.environ.get("HELIXKIT_BEARER_TOKEN")
    )
    if not bearer_token:
        print("SOULSHOUSE_BEARER_TOKEN is missing", file=sys.stderr)
        return 65

    manifest_path = Path(
        os.environ.get("SOULSHOUSE_SERVICES_FILE")
        or os.environ.get("HELIXKIT_SERVICES_FILE")
        or "/run/helixkit/services.yml"
    )
    try:
        manifest = yaml.safe_load(manifest_path.read_text()) or {}
    except FileNotFoundError:
        print(f"service manifest not found: {manifest_path}", file=sys.stderr)
        return 66
    except yaml.YAMLError as error:
        print(f"service manifest is invalid: {error}", file=sys.stderr)
        return 66

    try:
        connection = select_connection(manifest, connection_id)
        endpoint = connection["credentials"]["access_token_endpoint"]
        access_token = fetch_access_token(endpoint, bearer_token)
    except (KeyError, ValueError) as error:
        print(str(error), file=sys.stderr)
        return 66
    except RedirectRefusedError as error:
        print(f"Souls token broker returned HTTP {error.code} ({error.reason})", file=sys.stderr)
        return 1
    except urllib.error.HTTPError as error:
        print(f"Souls token broker returned HTTP {error.code}", file=sys.stderr)
        return 1
    except Exception as error:
        print(f"Could not obtain a Google access token: {error}", file=sys.stderr)
        return 1

    if command == "exec":
        environment = os.environ.copy()
        environment["GOOGLE_COLAB_ACCESS_TOKEN"] = access_token
        os.execvpe(rest[0], rest, environment)

    if command in ("ccu-info", "status"):
        return run_ccu_info(access_token)

    return run_check(connection.get("connection_id"), access_token)


def parse_args(arguments: list[str]) -> tuple[str | None, list[str]]:
    connection_id = None
    remaining = []
    iterator = iter(arguments)
    for argument in iterator:
        if argument == "--":
            remaining.append(argument)
            remaining.extend(iterator)
            break
        if argument == "--connection" and not remaining:
            try:
                connection_id = next(iterator)
            except StopIteration as error:
                raise SystemExit("--connection requires a service connection id") from error
        elif argument.startswith("--connection=") and not remaining:
            connection_id = argument.split("=", 1)[1]
        else:
            remaining.append(argument)
    return connection_id, remaining


def describe_connection(service: dict) -> str:
    text = service.get("connection_id", "?")
    identity = service.get("identity") or service.get("label")
    origin = service.get("origin") or {}
    detail = ", ".join(
        part
        for part in [identity, f"via {origin.get('account')}" if origin.get("guest") else None]
        if part
    )
    return f"{text} ({detail})" if detail else text


def select_connection(manifest: dict, connection_id: str | None) -> dict:
    connections = [
        service
        for service in manifest.get("services", [])
        if service.get("provider") == "google_workspace"
    ]
    if connection_id:
        connections = [
            service
            for service in connections
            if service.get("connection_id") == connection_id
        ]
        if not connections:
            raise ValueError(f"Google Workspace connection not found: {connection_id}")
    elif len(connections) > 1:
        colab_enabled = [
            service
            for service in connections
            if ((service.get("access") or {}).get("authority") or {}).get("colab") not in (None, "none")
        ]
        if len(colab_enabled) == 1:
            return colab_enabled[0]
        ids = ", ".join(describe_connection(service) for service in connections)
        raise ValueError(
            f"Several Google Workspace connections are available ({ids}); "
            "choose one with --connection"
        )

    if not connections:
        raise ValueError("No Google Workspace connection is provisioned to this resident")
    return connections[0]


def fetch_access_token(endpoint: str, bearer_token: str) -> str:
    request = urllib.request.Request(
        endpoint,
        headers={
            "Authorization": f"Bearer {bearer_token}",
            "Accept": "application/json",
        },
    )
    with NO_REDIRECT_OPENER.open(request, timeout=30) as response:
        payload = json.loads(response.read().decode("utf-8"))
    token = payload.get("access_token")
    if not token:
        raise ValueError("Souls token broker returned no access token")
    return token


def strip_xssi(body: str) -> str:
    if body.startswith(XSSI_PREFIX):
        return body[len(XSSI_PREFIX):]
    return body


def colab_get(url: str, access_token: str) -> tuple[int, str]:
    request = urllib.request.Request(
        url,
        headers={
            "Authorization": f"Bearer {access_token}",
            "Accept": "application/json",
            "X-Colab-Client-Agent": "vscode",
        },
    )
    try:
        with NO_REDIRECT_OPENER.open(request, timeout=30) as response:
            return response.status, response.read().decode("utf-8", errors="replace")
    except urllib.error.HTTPError as error:
        return error.code, error.read().decode("utf-8", errors="replace")


def fetch_tokeninfo(access_token: str) -> tuple[int, list[str]]:
    data = urllib.parse.urlencode({"access_token": access_token}).encode("utf-8")
    request = urllib.request.Request(
        TOKENINFO_URL,
        data=data,
        method="POST",
        headers={
            "Content-Type": "application/x-www-form-urlencoded",
            "Accept": "application/json",
        },
    )
    try:
        with NO_REDIRECT_OPENER.open(request, timeout=30) as response:
            payload = json.loads(response.read().decode("utf-8"))
            scopes = sorted(str(payload.get("scope") or "").split())
            return response.status, scopes
    except urllib.error.HTTPError as error:
        return error.code, []


def run_ccu_info(access_token: str) -> int:
    status, body = colab_get(f"{COLAB_ORIGIN}/tun/m/ccu-info", access_token)
    cleaned = strip_xssi(body).strip()
    if status != 200:
        print(f"Colab ccu-info returned HTTP {status}", file=sys.stderr)
        return 1
    try:
        parsed = json.loads(cleaned)
        print(json.dumps(parsed, indent=2, sort_keys=True))
    except json.JSONDecodeError:
        print(cleaned)
    return 0


def probe_endpoint(url: str, access_token: str) -> int | str:
    try:
        status, _ = colab_get(url, access_token)
        return status
    except (urllib.error.URLError, TimeoutError, OSError) as error:
        return f"transport_error:{type(error).__name__}"


def run_check(connection_id: str | None, access_token: str) -> int:
    tokeninfo_status, scopes = fetch_tokeninfo(access_token)

    session_status = probe_endpoint(f"{COLAB_ORIGIN}/tun/m/ccu-info", access_token)
    public_runtimes_status = probe_endpoint(
        f"{COLAB_PUBLIC_API_ORIGIN}/v1beta/runtimes", access_token
    )
    pa_user_info_status = probe_endpoint(f"{COLAB_PA_ORIGIN}/v1/user-info", access_token)

    has_scope = COLABORATORY_SCOPE in scopes
    report = {
        "connection_id": connection_id,
        "tokeninfo_status": tokeninfo_status,
        "scopes": scopes,
        "has_colaboratory_scope": has_scope,
        "endpoints": {
            "colab_session_ccu_info": session_status,
            "colab_public_runtimes": public_runtimes_status,
            "colab_pa_user_info_unverified": pa_user_info_status,
        },
    }
    print(json.dumps(report, indent=2, sort_keys=True))
    return 0 if (tokeninfo_status == 200 and has_scope) else 1


if __name__ == "__main__":
    raise SystemExit(main())
