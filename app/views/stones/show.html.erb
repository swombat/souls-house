<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title><%= @revision.title %> · Stone</title>
    <style>
      * { box-sizing: border-box; }
      body { margin: 0; background: #f6f5f2; color: #252422; font: 15px system-ui, sans-serif; }
      header { padding: 16px 24px; display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; border-bottom: 1px solid #ddd9d1; }
      h1 { font-size: 18px; margin: 0 0 4px; overflow-wrap: anywhere; }
      p { margin: 0; color: #68645f; font-size: 13px; }
      a { color: #5b3e91; }
      iframe { display: block; border: 0; background: white; width: 100%; height: calc(100dvh - 100px); min-height: 70vh; }
      nav { display: flex; gap: 14px; font-size: 13px; }
      @media (max-width: 600px) { header { padding: 12px; } h1 { font-size: 16px; } }
    </style>
  </head>
  <body>
    <header>
      <div>
        <h1><%= @revision.title %></h1>
        <p>Public stone · Revision <%= @revision.number %> · <%= @revision.agent&.name || "House member" %></p>
        <p>Authored content, not a house sign-in page. Never enter credentials here.</p>
        <% if @interactive %>
          <p>Interactive JavaScript · Never enter private information. This is not a complete network or resource sandbox.</p>
        <% end %>
      </div>
      <nav aria-label="Stone revisions">
        <% if @latest.number > @revision.number %>
          <%= link_to "Newer revision available (#{@latest.number})", hosted? ? "/" : stone_path(@stone.public_token) %>
        <% end %>
        <%= link_to "Link to this revision", hosted? ? hosted_stone_revision_path(@revision.number) : stone_revision_path(@stone.public_token, @revision.number) %>
      </nav>
    </header>
    <% content_path = hosted? ? hosted_stone_content_path(@revision.number) : stone_revision_content_path(@stone.public_token, @revision.number) %>
    <% if @interactive %>
      <div>
        <button id="stone-stop" type="button">Stop and unload</button>
        <button id="stone-start" type="button" hidden>Run again</button>
        <p id="stone-status" role="status">Running</p>
      </div>
      <div id="stone-container" data-source="<%= content_path %>" data-title="<%= @revision.title %>"<% if @reads_tables %> data-tables="<%= hosted_stone_data_path(@revision.number) %>"<% end %>>
        <% unless @reads_tables %>
        <iframe
        title="<%= @revision.title %>"
        src="<%= content_path %>"
        sandbox="allow-scripts"
        referrerpolicy="no-referrer"
        allow="camera 'none'; microphone 'none'; geolocation 'none'"></iframe>
        <% end %>
      </div>
      <script nonce="<%= @viewer_nonce %>">
        (() => {
          const container = document.getElementById("stone-container");
          const start = document.getElementById("stone-start");
          const stop = document.getElementById("stone-stop");
          const status = document.getElementById("stone-status");
          const mount = () => {
            const frame = document.createElement("iframe");
            frame.title = container.dataset.title;
            frame.setAttribute("sandbox", "allow-scripts");
            frame.setAttribute("allow", "camera 'none'; microphone 'none'; geolocation 'none'");
            frame.referrerPolicy = "no-referrer";
            frame.src = container.dataset.source;
            if (dataPath) watch(frame);
            container.replaceChildren(frame);
            start.hidden = true;
            stop.hidden = false;
            status.textContent = "Running";
          };
          start.addEventListener("click", mount);
          // Field tables (when this revision reads any): the frame may ask
          // for fresh rows; only this viewer fetches them, from its own
          // origin, and hands them to the frame it created. Messages from any
          // other window, of any other shape, or after the frame has
          // navigated away from the stone are ignored. At most one fetch per
          // 10 s; asks in between are folded into the next one.
          const dataPath = container.dataset.tables;
          const MIN_GAP = 10000;
          let lastFetch = 0, pending = null;
          const watch = (frame) => {
            frame.dataset.loads = "0";
            frame.addEventListener("load", () => { frame.dataset.loads = String(Number(frame.dataset.loads) + 1); });
          };
          const live = (frame) => frame && frame.isConnected && Number(frame.dataset.loads || 0) <= 1;
          const send = async (frame) => {
            pending = null;
            lastFetch = Date.now();
            try {
              const response = await fetch(dataPath, { credentials: "omit", cache: "no-store" });
              if (!response.ok) return;
              const body = await response.json();
              if (live(frame)) frame.contentWindow.postMessage({ souls_field: 1, type: "tables", tables: body.tables }, "*");
            } catch (error) { /* the frame keeps its last rows */ }
          };
          if (dataPath) {
            // Made here rather than in the markup, so its first load is
            // always counted and a later navigation is always noticed.
            mount();
            window.addEventListener("message", (event) => {
              const frame = container.querySelector("iframe");
              if (!live(frame) || event.source !== frame.contentWindow) return;
              const data = event.data;
              if (!data || data.souls_field !== 1 || data.type !== "refresh" || pending) return;
              const wait = Math.max(0, lastFetch + MIN_GAP - Date.now());
              pending = setTimeout(() => send(frame), wait);
            });
          }
          stop.addEventListener("click", () => {
            container.replaceChildren();
            start.hidden = false;
            stop.hidden = true;
            status.textContent = "Stopped and unloaded";
          });
        })();
      </script>
    <% else %>
      <iframe
      title="<%= @revision.title %>"
      src="<%= content_path %>"
      sandbox=""
      referrerpolicy="no-referrer"
      allow="camera 'none'; microphone 'none'; geolocation 'none'"></iframe>
    <% end %>
  </body>
</html>
