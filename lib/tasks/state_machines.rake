namespace :state_machines do
  desc "Regenerate docs/state-machines.md with Mermaid diagrams (development)"
  task diagrams: :environment do
    abort "Run with RAILS_ENV=development; the Mermaid renderer is development-only." unless Rails.env.development?

    require "state_machines-mermaid"
    require "stringio"

    Rails.application.eager_load!
    classes = ObjectSpace.each_object(Class).select do |klass|
      klass.name && klass.respond_to?(:state_machines) && klass.state_machines.any?
    end

    document = StringIO.new
    document.puts "# State machines"
    document.puts "\n<!-- Generated by bin/rails state_machines:diagrams. -->"

    classes.sort_by(&:name).each do |klass|
      document.puts "\n## #{klass.name}"
      klass.state_machines.sort_by { |name, _| name.to_s }.each do |name, machine|
        document.puts "\n### #{name}" if klass.state_machines.size > 1
        document.puts "\n```mermaid"
        machine.draw(io: document, show_conditions: true)
        document.puts "```"
      end
    end

    path = Rails.root.join("docs/state-machines.md")
    path.write(document.string)
    puts "Wrote #{path.relative_path_from(Rails.root)}"
  end
end
