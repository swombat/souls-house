{
  "sensitive_name": "(token|secret|password|passwd|credential|authorization|cookie|api[_-]?key|access[_-]?key|private[_-]?key|client[_-]?key)",
  "secret_patterns": [
    "(sk-[A-Za-z0-9_-]{12,}|gh[pousr]_[A-Za-z0-9_]{12,}|github_pat_[A-Za-z0-9_]{12,}|AKIA[A-Z0-9]{16})",
    "eyJ[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+",
    "[A-Za-z0-9_+=-]{48,}"
  ],
  "private_value_flags": [
    "-H", "--header", "--proxy-header", "-u", "--user", "--proxy-user",
    "-d", "--data", "--data-raw", "--data-binary", "--data-urlencode",
    "--json", "-F", "--form", "--form-string", "-b", "--cookie",
    "--password", "--passwd", "--token", "--api-key", "--access-token",
    "--secret", "--client-secret", "--private-key", "--key", "--pass",
    "--oauth2-bearer"
  ],
  "script_commands": ["python", "python3", "ruby", "node", "perl", "php", "osascript"],
  "script_flags": ["-c", "-e", "--eval", "-r"],
  "shells": ["sh", "bash", "zsh", "dash"]
}
