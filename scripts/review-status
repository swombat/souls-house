#!/usr/bin/env python3
"""Record a review, or arm auto-merge, for a pull request on this repository.

Every contributor pushes as the same GitHub user, so GitHub's own Approve is
impossible. A review is a commit status instead: `review/<who>` on the exact
head the reviewer read. The "Protect Main" ruleset requires `CI result` and
`review/quorum`. The Review quorum workflow writes that one after every
`review/<who>` status, from what GitHub holds for the head (Daniel, YmqMbY,
26 Nov): green once two residents' slots are green (the builder's own slot
plus one reviewer's), red while any slot holds a block, pending otherwise.
So GitHub merges on the builder plus one review, and a block still holds it.

The quorum is recomputed by a workflow, so for a while after a block it can
still read green. A block therefore turns the PR into a draft first, before
its status is written: GitHub will not merge a draft and drops its auto-merge,
and that happens in GitHub's own state, not in a workflow that may be queued.
The quorum job drafts the PR too when it sees a block written some other way.
`auto-merge` marks the PR ready again; the quorum still holds while any slot
on that head is blocked.

    scripts/review-status <pr> <sha> auto-merge "Lume: builder"
    scripts/review-status <pr> <sha> approve "Mira: read the whole diff"
    scripts/review-status <pr> <sha> block "Mira: the lock is taken too late"
    scripts/review-status quorum <sha>     # the workflow's step; safe to rerun

<sha> is the head you read (seven characters or more). The script reads the
PR's current head and refuses if they differ, so a push nobody read can't be
approved by mistake. A new head starts with every slot empty, so the builder
runs auto-merge again after each push.

The token comes from GITHUB_TOKEN or GH_TOKEN, else from `git credential fill`.
"""
import json
import os
import subprocess
import sys
import urllib.error
import urllib.request

REPO = os.environ.get("REVIEW_STATUS_REPO", "swombat/souls-house")
API = "https://api.github.com"
CONTEXT = "review"
STATES = {"approve": "success", "block": "failure", "auto-merge": "success"}
# The slots that count towards review/quorum; a new resident who reviews needs adding here.
RESIDENTS = ("lume", "mira", "reed")
QUORUM_CONTEXT = f"{CONTEXT}/quorum"
QUORUM = 2
MIN_SHA = 7
MAX_DESCRIPTION = 140


class Refused(Exception):
    pass


def token():
    for name in ("GITHUB_TOKEN", "GH_TOKEN"):
        if os.environ.get(name):
            return os.environ[name]
    filled = subprocess.run(
        ["git", "credential", "fill"],
        # usehttppath helpers only answer when the repository path is given.
        input=f"protocol=https\nhost=github.com\npath={REPO}.git\n\n",
        capture_output=True,
        text=True,
        check=False,
    ).stdout
    for line in filled.splitlines():
        if line.startswith("password="):
            return line.split("=", 1)[1]
    raise Refused("no GitHub token: set GITHUB_TOKEN or configure a git credential for github.com")


def request(method, url, auth, body=None):
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(url, data=data, method=method)
    req.add_header("Authorization", f"Bearer {auth}")
    req.add_header("Accept", "application/vnd.github+json")
    if data is not None:
        req.add_header("Content-Type", "application/json")
    try:
        with urllib.request.urlopen(req, timeout=30) as response:
            return json.loads(response.read() or b"null")
    except urllib.error.HTTPError as error:
        raise Refused(f"{method} {url} failed: {error.code} {error.read().decode(errors='replace')[:300]}")


def check_head(pull, reviewed_sha):
    if pull.get("state") != "open":
        raise Refused(f"PR #{pull['number']} is {pull.get('state')}, not open")
    head = pull["head"]["sha"]
    reviewed = reviewed_sha.lower()
    if len(reviewed) < MIN_SHA:
        raise Refused(f"give at least {MIN_SHA} characters of the head you reviewed")
    if not head.startswith(reviewed):
        raise Refused(f"PR #{pull['number']} head is now {head[:12]}, not {reviewed}: read the new head first")
    return head


def reviewer_slug(note):
    who = note.split(":", 1)[0].strip().lower() if ":" in note else ""
    if who not in RESIDENTS:
        raise Refused(f'say who you are: "<who>: <why>", with <who> one of {", ".join(RESIDENTS)}')
    return who


def clip(text):
    text = " ".join(text.split())
    return text if len(text) <= MAX_DESCRIPTION else text[: MAX_DESCRIPTION - 1] + "…"


def status_body(verdict, note):
    if verdict not in STATES:
        raise Refused(f"verdict must be one of {', '.join(STATES)}")
    note = " ".join(note.split())
    return {"state": STATES[verdict], "context": f"{CONTEXT}/{reviewer_slug(note)}", "description": clip(note)}


def graphql(query, node_id, auth, what):
    result = request("POST", f"{API}/graphql", auth, {"query": query, "variables": {"id": node_id}})
    if result.get("errors"):
        raise Refused(f"{what}: {result['errors'][0].get('message')}")
    return result


def convert_to_draft(pull, auth):
    if pull.get("draft"):
        return
    graphql(
        "mutation($id: ID!) { convertPullRequestToDraft(input: {pullRequestId: $id}) { pullRequest { isDraft } } }",
        pull["node_id"], auth, f"#{pull['number']} not turned into a draft",
    )
    print(f"#{pull['number']}: now a draft, so GitHub cannot merge it")


def mark_ready(pull, auth):
    if not pull.get("draft"):
        return
    graphql(
        "mutation($id: ID!) { markPullRequestReadyForReview(input: {pullRequestId: $id}) { pullRequest { isDraft } } }",
        pull["node_id"], auth, f"#{pull['number']} not marked ready",
    )


def enable_auto_merge(pull, auth):
    mutation = (
        "mutation($id: ID!) { enablePullRequestAutoMerge(input: {pullRequestId: $id, mergeMethod: SQUASH})"
        " { pullRequest { number autoMergeRequest { mergeMethod } } } }"
    )
    graphql(mutation, pull["node_id"], auth, f"auto-merge not enabled on #{pull['number']}")


def quorum(statuses):
    """The combined review verdict for one head, from its latest statuses.

    Only resident slots count, so neither review/quorum itself nor a stray
    context can satisfy it. A block anywhere wins over any number of approvals.
    """
    slots = {}
    for status in statuses:
        context = status.get("context", "")
        who = context.split("/", 1)[1] if context.startswith(f"{CONTEXT}/") else ""
        if who in RESIDENTS and who not in slots:
            # The combined-status API lists each context once, newest first.
            slots[who] = status.get("state")
    blocked = sorted(who for who, state in slots.items() if state in ("failure", "error"))
    if blocked:
        return "failure", clip(f"held by a block from {', '.join(blocked)}")
    green = sorted(who for who, state in slots.items() if state == "success")
    if len(green) >= QUORUM:
        return "success", clip(f"{' + '.join(green)}: {len(green)} of {QUORUM} needed")
    have = f" ({green[0]} so far)" if green else ""
    return "pending", clip(f"{len(green)} of {QUORUM} review slots green{have}: waiting for a reviewer")


def write_quorum(sha, auth):
    if len(sha) < MIN_SHA:
        raise Refused(f"give at least {MIN_SHA} characters of the head")
    combined = request("GET", f"{API}/repos/{REPO}/commits/{sha}/status?per_page=100", auth)
    state, description = quorum(combined.get("statuses") or [])
    head = combined.get("sha") or sha
    body = {"state": state, "context": QUORUM_CONTEXT, "description": description}
    request("POST", f"{API}/repos/{REPO}/statuses/{head}", auth, body)
    print(f"{head[:12]}: {QUORUM_CONTEXT} {state} ({description})")
    if state == "failure":
        # A block written without this script didn't draft its PR; do it here.
        for pull in request("GET", f"{API}/repos/{REPO}/commits/{head}/pulls", auth) or []:
            if pull.get("state") == "open" and pull["head"]["sha"] == head:
                convert_to_draft(pull, auth)


def review(number, reviewed_sha, verdict, note, auth):
    body = status_body(verdict, note)
    pull = request("GET", f"{API}/repos/{REPO}/pulls/{number}", auth)
    head = check_head(pull, reviewed_sha)
    if verdict == "block":
        # Before the status: the quorum may still read green until its job runs.
        convert_to_draft(pull, auth)
    request("POST", f"{API}/repos/{REPO}/statuses/{head}", auth, body)
    print(f"#{number} {head[:12]}: {body['context']} {body['state']} ({body['description']})")
    if verdict == "auto-merge":
        mark_ready(pull, auth)
        enable_auto_merge(pull, auth)
        print(f"#{number}: auto-merge (squash) on; GitHub merges when CI result and {QUORUM_CONTEXT} are green")


def main(argv):
    try:
        if len(argv) == 2 and argv[0] == "quorum":
            write_quorum(argv[1], token())
        elif len(argv) == 4:
            review(int(argv[0]), argv[1], argv[2], argv[3], token())
        else:
            print(__doc__.strip(), file=sys.stderr)
            return 2
    except Refused as refusal:
        print(f"review-status: {refusal}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
