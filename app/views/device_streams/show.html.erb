<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Device stream controls</title><%= csrf_meta_tags %></head>
<body><main>
  <h1><%= @stream.name %></h1>
  <p>Account: <strong><%= @stream.account.name %></strong></p>
  <% unless @stream_account %>
    <p>Personal recovery controls: you may revoke devices or delete data here. Reader changes and new credentials require account membership.</p>
    <% if Current.user.confirmed_accounts.exists?(@stream.account_id) %>
      <%= link_to "Manage in account", account_device_stream_path(@stream.account, @stream.stream_key) %>
    <% end %>
  <% end %>
  <p>Stream key: <code><%= @stream.stream_key %></code></p>
  <p>Readers may analyse RR data; this does not authorize publication.
    As everywhere in this house, deleting hides data, it does not destroy it: deleted sessions disappear from every reader and
    device, but the samples stay stored on the server and in its backups. Mac files, downloaded copies and derived findings
    are not affected. Infrastructure administrators can access stored data. If you need data truly gone, run your own house.</p>
  <% if @stream.erased_at? %><p>This stream is deleted and closed. It cannot ingest again.</p><% else %>
    <% if @stream_account %>
    <%= form_with url: stream_controls_path, method: :patch, local: true do %>
      <fieldset><legend>Readers (explicit selection; future house members are not automatically added)</legend>
        <% @users.each do |user| %>
          <label><%= check_box_tag "reader_user_ids[]", user.to_param, @stream.reader_user_ids.include?(user.id) %> <%= user.display_name %></label><br>
        <% end %>
        <% @agents.each do |agent| %>
          <label><%= check_box_tag "reader_agent_ids[]", agent.to_param, @stream.reader_agent_ids.include?(agent.id) %> <%= agent.name %> (agent)</label><br>
        <% end %>
      </fieldset>
      <label><%= check_box_tag "enabled", "1", @stream.enabled? %> Enable device ingestion</label>
      <%= submit_tag "Save readers and ingestion choice" %>
    <% end %>
    <% end %>
    <h2>Devices</h2>
    <%= button_to "Create append-only device credential", stream_controls_path(:credential) if @stream_account %>
    <ul><% @stream.device_stream_credentials.order(created_at: :desc).each do |credential| %>
      <li>Created <%= credential.created_at.utc %> —
      <% if credential.revoked_at? %>revoked<% else %>
        <%= button_to "Revoke device", stream_controls_path(:revoke, credential_id: credential.to_param), method: :delete %>
      <% end %></li>
    <% end %></ul>
    <h2>Sessions (newest 100)</h2>
    <ul><% @sessions.each do |session| %>
      <li><code><%= session.session_uuid %></code>
      <% if session.erased_at? %> deleted<% else %>
        <%= button_to "Delete session", stream_controls_path(:erase_session, session_id: session.session_uuid), method: :delete %>
      <% end %></li>
    <% end %></ul>
    <h2>Delete an older session by UUID</h2>
    <%= form_with url: stream_controls_path(:erase_session), method: :delete, local: true do |f| %>
      <%= f.label :session_id, "Session UUID" %><%= f.text_field :session_id, required: true %><%= f.submit "Delete session" %>
    <% end %>
    <h2>Delete all and close</h2>
    <p>This hides every session from every reader and revokes every device. The samples stay stored. You cannot reopen this stream.</p>
    <%= button_to "Delete all sessions and close stream", stream_controls_path, method: :delete %>
  <% end %>
  <%= link_to "Your streams", stream_index_path %>
</main></body></html>
