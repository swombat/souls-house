<!DOCTYPE html>
<html <%= tag.attributes(html_theme_attributes) %>>
  <head>
    <title><%= content_for(:title) || Setting.instance.site_name %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,interactive-widget=resizes-content">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>
    <%= render "layouts/share_video" if @share_video %>

    <%# Installable app: the manifest gives a home-screen icon with no browser bar. %>
    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>
    <meta name="apple-mobile-web-app-title" content="souls.house">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">

    <%= favicon_link_tag "/favicon.ico", type: "image/x-icon" %>
    <%= favicon_link_tag "/favicon.svg", type: "image/svg+xml" %>
    <%= favicon_link_tag "/apple-touch-icon.png", rel: "apple-touch-icon", type: "image/png" %>

    <%= vite_stylesheet_tag "application" %>
    <%= vite_client_tag %>
    <%= vite_javascript_tag "inertia" %>
    <%= inertia_ssr_head %>
    <%= vite_javascript_tag 'application' %>
  </head>

  <body>
    <%= yield %>
  </body>
</html>
