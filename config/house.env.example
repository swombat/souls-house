# config/house.env.example
#
# Copy this file to config/house.env (gitignored) and fill it in. That file
# is what turns this checkout into a running installation: config/deploy.yml,
# bin/kamal, bin/house and scripts/build-agent-runtime all read it. Nothing
# else in the repository should name a specific installation — see
# public/self-host.md.
#
# HOUSE_* = deploy-time knobs, read by Kamal's ERB and the deploy scripts.
# SOULSHOUSE_* = runtime config the Rails app reads; deploy.yml derives those
# from the HOUSE_* values below. Explicit runtime opt-ins below are forwarded too.

# Explicit deployment choice: 0 until the runtime fleet/canary is verified, then 1.
# Keep this in house.env; an omitted/invalid value fails deployment rather than
# silently reverting to synchronous workers. See docs/resident-concurrency.md.
SOULSHOUSE_ASYNC_TURNS=0

# Public hostname. Used for the Kamal proxy, TLS, and SOULSHOUSE_PUBLIC_URL /
# SOULSHOUSE_ACTIVITY_ORIGIN (both become https://HOUSE_DOMAIN).
HOUSE_DOMAIN=house.example.org

# The Docker host's IP or hostname. web, jobs, and both accessories deploy
# here; also stored on promoted agents as SOULSHOUSE_SANDBOX_HOST.
HOUSE_HOST=203.0.113.10

# SSH access to HOUSE_HOST.
HOUSE_SSH_USER=deploy
HOUSE_SSH_PORT=22

# Where the app image is pushed and pulled from, e.g. "yourregistry/souls-house".
# The build cache image is derived as "HOUSE_IMAGE:production-build-cache".
HOUSE_IMAGE=yourregistry/souls-house

# Username for the registry above (registry.username in deploy.yml).
HOUSE_REGISTRY_USER=yourregistry

# The mnemodyne embeddings accessory image (without a tag or digest).
HOUSE_EMBEDDINGS_IMAGE=yourregistry/souls-house-mnemodyne-embeddings

# The published embeddings image's immutable manifest digest (sha256:...).
# Produced by releasing the embeddings accessory — see
# docs/mnemodyne-deployment.md. Leave blank until you've released one; Kamal
# will refuse to render config/deploy.yml until this (or the compatibility
# MNEMODYNE_EMBEDDING_IMAGE_DIGEST override) is set.
HOUSE_EMBEDDINGS_DIGEST=

# HOUSE_HOST's docker socket group, so the non-root rails user in the web and
# jobs containers can use the mounted /var/run/docker.sock. Leave blank for
# now — `bin/house doctor` reads it from the host and fills it in.
HOUSE_DOCKER_GID=

# Remote Docker host to build the app image on, e.g.
# "ssh://deploy@203.0.113.10:22". Leave blank to build locally instead
# (omits builder.remote; a configured remote disables local compilation).
# For a local build, HOUSE_HOST's architecture must match your build machine's.
HOUSE_BUILDER_REMOTE=

# Default agent runtime image tag, injected as SOULSHOUSE_AGENT_IMAGE_DEFAULT.
HOUSE_AGENT_IMAGE=helixkit-agent-runtime:latest

# Docker host that scripts/build-agent-runtime builds the agent runtime
# image on. Optional — defaults to
# ssh://HOUSE_SSH_USER@HOUSE_HOST:HOUSE_SSH_PORT when blank.
HOUSE_AGENT_RUNTIME_DOCKER_HOST=

# Where Active Storage keeps uploads: "s3" or "local". "local" adds a Kamal
# volume (souls_house_storage:/rails/storage) on web and jobs instead of
# requiring an S3-compatible bucket.
HOUSE_STORAGE=s3

# Site name and mail sender, injected as SOULSHOUSE_SITE_NAME /
# SOULSHOUSE_MAIL_FROM. Leave HOUSE_MAIL_FROM blank to use the app's default.
HOUSE_SITE_NAME=Souls House
HOUSE_MAIL_FROM=

# This installation's GitHub repository as owner/name (your fork, e.g.
# "youraccount/souls-house"). The Site Admin menu reads it to show what's
# deployed, and Site Admin → Deploy starts that repository's deploy workflows.
# Leave blank only if you deploy the upstream repository itself.
HOUSE_SOURCE_REPO=

# Comma-separated extra network-alias entries on the web service, for
# containers elsewhere that still call it by an old name. The
# "souls-house-web" alias is always present regardless of this setting.
# Leave blank on a fresh install.
HOUSE_TRANSITION_ALIASES=
