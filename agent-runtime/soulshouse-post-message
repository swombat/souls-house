#!/usr/bin/env python3
"""
Post an assistant message back to souls.house as the current external agent.

Usage:
  printf 'message text' | soulshouse-post-message CHAT_ID
  soulshouse-post-message CHAT_ID "short shell-safe text"  # compatibility only
  printf 'caption' | soulshouse-post-message CHAT_ID --attach /tmp/image.png
  soulshouse-post-message CHAT_ID --attach image.png --attach notes.pdf "Files attached"

`helixkit-post-message` is a permanent alias for this command.

Prefer stdin. A shell parses an argv message before this helper receives it, so
double-quoted text containing $, backticks, or substitutions may be corrupted.

Requires SOULSHOUSE_APP_URL and SOULSHOUSE_BEARER_TOKEN in the environment
(the older HELIXKIT_APP_URL / HELIXKIT_BEARER_TOKEN names still work).
Never prints the bearer token.
"""

import argparse
import json
import mimetypes
import os
from pathlib import Path
import sys
import urllib.error
import urllib.request
import uuid


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="soulshouse-post-message",
        description="Post a message and optional local files to a souls.house conversation.",
        epilog="Full souls.house manual: /usr/local/share/helixkit-agent/soulshouse-api.md",
    )
    parser.add_argument("chat_id")
    parser.add_argument("message", nargs="?")
    parser.add_argument(
        "--attach",
        action="append",
        default=[],
        metavar="PATH",
        help="attach a local file; repeat for multiple files",
    )
    args = parser.parse_args()

    # HELIXKIT_* are the pre-rename names. Keep reading them: an older container
    # injected only those, and a newer image must still work inside it.
    app_url = os.environ.get("SOULSHOUSE_APP_URL") or os.environ.get("HELIXKIT_APP_URL")
    token = os.environ.get("SOULSHOUSE_BEARER_TOKEN") or os.environ.get("HELIXKIT_BEARER_TOKEN")
    if not app_url:
        print("SOULSHOUSE_APP_URL is missing", file=sys.stderr)
        return 65
    if not token:
        print("SOULSHOUSE_BEARER_TOKEN is missing", file=sys.stderr)
        return 65

    chat_id = args.chat_id
    content = args.message if args.message is not None else sys.stdin.read()
    content = normalize_newlines(content)
    content = content.strip()
    attachments = [Path(path).expanduser() for path in args.attach]

    missing = [str(path) for path in attachments if not path.is_file()]
    if missing:
        print(f"attachment not found: {missing[0]}", file=sys.stderr)
        return 66

    if not content and not attachments:
        print("message content and attachments are empty", file=sys.stderr)
        return 66

    url = f"{app_url.rstrip('/')}/api/v1/conversations/{chat_id}/messages"
    if attachments:
        body, content_type = multipart_body(content, attachments)
    else:
        body = json.dumps({"content": content}).encode("utf-8")
        content_type = "application/json"

    request = urllib.request.Request(
        url,
        data=body,
        headers={
            "Authorization": f"Bearer {token}",
            "Content-Type": content_type,
            "Accept": "application/json",
        },
        method="POST",
    )

    try:
        with urllib.request.urlopen(request, timeout=120) as response:
            payload = response.read().decode("utf-8")
            print(payload)
            return 0 if 200 <= response.status < 300 else 1
    except urllib.error.HTTPError as error:
        print(f"souls.house returned HTTP {error.code}", file=sys.stderr)
        print(error.read().decode("utf-8", errors="replace"), file=sys.stderr)
        return 1
    except Exception as error:
        print(f"souls.house post failed: {error}", file=sys.stderr)
    return 1


def normalize_newlines(content: str) -> str:
    """Accept either real newlines or common shell-escaped newline sequences.

    Agents often invoke this helper as:

        soulshouse-post-message CHAT_ID "line one\n\nline two"

    In POSIX shells that double-quoted argument arrives as literal backslash+n
    characters, not line breaks. Convert those to actual newlines before sending
    JSON to souls.house. Stdin input with real newlines is left alone.
    """
    return content.replace("\\r\\n", "\n").replace("\\n", "\n")


def multipart_body(content: str, attachments: list[Path]) -> tuple[bytes, str]:
    boundary = f"soulshouse-{uuid.uuid4().hex}"
    chunks = []

    def add(value: bytes) -> None:
        chunks.append(value)
        chunks.append(b"\r\n")

    add(f"--{boundary}".encode())
    add(b'Content-Disposition: form-data; name="content"')
    add(b"")
    add(content.encode("utf-8"))

    for path in attachments:
        content_type = mimetypes.guess_type(path.name)[0] or "application/octet-stream"
        filename = path.name.replace('"', "_")
        add(f"--{boundary}".encode())
        add(
            f'Content-Disposition: form-data; name="files[]"; filename="{filename}"'.encode(
                "utf-8"
            )
        )
        add(f"Content-Type: {content_type}".encode())
        add(b"")
        add(path.read_bytes())

    chunks.append(f"--{boundary}--\r\n".encode())
    return b"".join(chunks), f"multipart/form-data; boundary={boundary}"


if __name__ == "__main__":
    raise SystemExit(main())
