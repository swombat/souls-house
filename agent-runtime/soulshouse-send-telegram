#!/usr/bin/env python3
"""
Send a direct Telegram message through souls.house as the current hosted agent.

Usage:
  soulshouse-send-telegram RECIPIENT "message text"
  printf 'message text' | soulshouse-send-telegram RECIPIENT
  printf 'caption' | soulshouse-send-telegram RECIPIENT --attach /tmp/image.png
  soulshouse-send-telegram RECIPIENT --attach /tmp/image.png
  soulshouse-send-telegram all "message text"
  soulshouse-send-telegram --reply-to THREAD_ID "message text"

`helixkit-send-telegram` is a permanent alias for this command.

RECIPIENT matches active Telegram subscribers for this agent by email/name
(case-insensitive substring). Requires SOULSHOUSE_APP_URL and
SOULSHOUSE_BEARER_TOKEN (the older HELIXKIT_* names still work).
Never prints bearer or bot tokens.
"""

import argparse
import io
import json
import mimetypes
import os
from pathlib import Path
import sys
import urllib.error
import urllib.parse
import urllib.request
import uuid


class RefuseRedirects(urllib.request.HTTPRedirectHandler):
    """Never follow a redirect: the request carries the house credential, and
    urllib would re-send it to whatever origin the Location names."""

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        target = urllib.parse.urlsplit(newurl).netloc or newurl
        message = (f"refused to follow a redirect ({code}) to {target} with the house credential; "
                   "check SOULSHOUSE_APP_URL")
        # The message is the body too, so handlers that print error.read() show it.
        raise urllib.error.HTTPError(req.full_url, code, message, headers, io.BytesIO(message.encode()))


NO_REDIRECT_OPENER = urllib.request.build_opener(RefuseRedirects)


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="soulshouse-send-telegram",
        description="Send a direct Telegram message and optional attachment through souls.house.",
        epilog="Full souls.house manual: /usr/local/share/helixkit-agent/soulshouse-api.md",
    )
    parser.add_argument("--reply-to", metavar="THREAD_ID")
    parser.add_argument("--attach", metavar="PATH")
    parser.add_argument("recipient", nargs="?")
    parser.add_argument("message", nargs="?")
    args = parser.parse_args()

    if not args.reply_to and not args.recipient:
        parser.error("RECIPIENT is required unless --reply-to is used")

    # HELIXKIT_* are the pre-rename names. Keep reading them: an older container
    # injected only those, and a newer image must still work inside it.
    app_url = os.environ.get("SOULSHOUSE_APP_URL") or os.environ.get("HELIXKIT_APP_URL")
    token = os.environ.get("SOULSHOUSE_BEARER_TOKEN") or os.environ.get("HELIXKIT_BEARER_TOKEN")
    if not app_url:
        print("SOULSHOUSE_APP_URL is missing", file=sys.stderr)
        return 65
    if not token:
        print("SOULSHOUSE_BEARER_TOKEN is missing", file=sys.stderr)
        return 65

    if args.reply_to:
        text_argument = args.message if args.message is not None else args.recipient
        recipient = None
    else:
        text_argument = args.message
        recipient = args.recipient

    # Argv retains escaped-newline convenience; stdin may contain literal code.
    text = normalize_newlines(text_argument) if text_argument is not None else sys.stdin.read()
    text = text.strip()
    attachment = Path(args.attach).expanduser() if args.attach else None

    if attachment and not attachment.is_file():
        print(f"attachment not found: {attachment}", file=sys.stderr)
        return 66
    if not text and not attachment:
        print("message text and attachment are empty", file=sys.stderr)
        return 66

    url = f"{app_url.rstrip('/')}/api/v1/telegram_messages"
    fields = {"text": text}
    run_id = os.environ.get("SOULSHOUSE_RUNTIME_RUN_ID") or os.environ.get("HELIXKIT_RUNTIME_RUN_ID")
    runtime_thread = (os.environ.get("SOULSHOUSE_RUNTIME_TELEGRAM_THREAD_ID")
                      or os.environ.get("HELIXKIT_RUNTIME_TELEGRAM_THREAD_ID"))
    if run_id and runtime_thread and (not args.reply_to or args.reply_to == runtime_thread):
        fields["runtime_run_id"] = run_id
    if args.reply_to:
        fields["reply_to"] = args.reply_to
    else:
        fields["recipient"] = recipient

    if attachment:
        body, content_type = multipart_body(fields, attachment)
    else:
        body = json.dumps(fields).encode("utf-8")
        content_type = "application/json"

    request = urllib.request.Request(
        url,
        data=body,
        headers={
            "Authorization": f"Bearer {token}",
            "Content-Type": content_type,
            "Accept": "application/json",
        },
        method="POST",
    )

    try:
        with NO_REDIRECT_OPENER.open(request, timeout=120 if attachment else 30) as response:
            payload = response.read().decode("utf-8")
            print(payload)
            return 0 if 200 <= response.status < 300 else 1
    except urllib.error.HTTPError as error:
        print(f"souls.house returned HTTP {error.code}", file=sys.stderr)
        print(error.read().decode("utf-8", errors="replace"), file=sys.stderr)
        return 1
    except Exception as error:
        print(f"souls.house Telegram send failed: {error}", file=sys.stderr)
        return 1


def normalize_newlines(content: str) -> str:
    return content.replace("\\r\\n", "\n").replace("\\n", "\n")


def multipart_body(fields: dict[str, str], attachment: Path) -> tuple[bytes, str]:
    boundary = f"soulshouse-{uuid.uuid4().hex}"
    chunks = []

    def add(value: bytes) -> None:
        chunks.append(value)
        chunks.append(b"\r\n")

    for name, value in fields.items():
        add(f"--{boundary}".encode())
        add(f'Content-Disposition: form-data; name="{name}"'.encode())
        add(b"")
        add(value.encode("utf-8"))

    content_type = mimetypes.guess_type(attachment.name)[0] or "application/octet-stream"
    filename = attachment.name.replace('"', "_")
    add(f"--{boundary}".encode())
    add(f'Content-Disposition: form-data; name="media"; filename="{filename}"'.encode("utf-8"))
    add(f"Content-Type: {content_type}".encode())
    add(b"")
    add(attachment.read_bytes())

    chunks.append(f"--{boundary}--\r\n".encode())
    return b"".join(chunks), f"multipart/form-data; boundary={boundary}"


if __name__ == "__main__":
    raise SystemExit(main())
