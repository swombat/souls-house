+#[tokio::test]
+async fn daily_cloud_code_replaces_prompt_and_rejects_unknown_generation() {
+    let prompt = AntigravitySystemPrompt::new("Canonical instructions".to_string());
+    for path in ["/v1internal:generateContent", GENERATE] {
+        let original = cloud_request();
+        let req = generation_request(path, original.clone());
+        let rewritten = prompt.rewrite(req, "daily-cloudcode-pa.googleapis.com").await.unwrap();
+        let mut expected = original;
+        expected["request"]["systemInstruction"] = json!({"parts": [{"text": "Canonical instructions"}]});
+        assert_eq!(payload(rewritten).await, expected);
+    }
+    let req = generation_request("/v2:generateContent", cloud_request());
+    assert!(prompt.rewrite(req, "daily-cloudcode-pa.googleapis.com").await.is_err());
+    let req = generation_request(GENERATE, cloud_request());
+    assert!(prompt.rewrite(req, "daily-cloudcode-pa.googleapis.com.evil.test").await.is_err());
+}
