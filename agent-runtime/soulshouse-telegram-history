#!/usr/bin/env python3
"""
Save a Telegram thread's messages to a file, without printing them.

Usage:
  soulshouse-telegram-history THREAD_ID [--after CURSOR] [--through CURSOR] [--out PATH]

A group wake that leaves a long backlog out names the exact command to run.
The file has one JSON object per line, oldest first (id, role, sender,
telegram_username, text, timestamp, media, reply_to_telegram_message_id, and
addressed_to_you: false on group messages nobody addressed to you). --after is
exclusive, --through inclusive; both take the message cursors a wake shows.
Only the count, the size and the path are printed, so the messages enter your
context only if you choose to read them: grep the file, read slices of it, or
give it to a sub-agent.

Requires SOULSHOUSE_APP_URL and SOULSHOUSE_BEARER_TOKEN (the older HELIXKIT_*
names still work). Never prints the bearer token.
"""

import argparse
import io
import json
import os
from pathlib import Path
import sys
import urllib.error
import urllib.parse
import urllib.request


class RefuseRedirects(urllib.request.HTTPRedirectHandler):
    """Never follow a redirect: the request carries the house credential."""

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        target = urllib.parse.urlsplit(newurl).netloc or newurl
        message = (f"refused to follow a redirect ({code}) to {target} with the house credential; "
                   "check SOULSHOUSE_APP_URL")
        raise urllib.error.HTTPError(req.full_url, code, message, headers, io.BytesIO(message.encode()))


NO_REDIRECT_OPENER = urllib.request.build_opener(RefuseRedirects)


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="soulshouse-telegram-history",
        description="Save a Telegram thread's messages to a JSONL file without printing them.",
        epilog="Full souls.house manual: /usr/local/share/helixkit-agent/soulshouse-api.md",
    )
    parser.add_argument("thread_id")
    parser.add_argument("--after", metavar="CURSOR", help="only messages after this cursor (exclusive)")
    parser.add_argument("--through", metavar="CURSOR", help="only messages up to this cursor (inclusive)")
    parser.add_argument("--out", metavar="PATH", help="file to write (default /tmp/telegram-THREAD_ID.jsonl)")
    args = parser.parse_args()

    app_url = os.environ.get("SOULSHOUSE_APP_URL") or os.environ.get("HELIXKIT_APP_URL")
    token = os.environ.get("SOULSHOUSE_BEARER_TOKEN") or os.environ.get("HELIXKIT_BEARER_TOKEN")
    if not app_url:
        print("SOULSHOUSE_APP_URL is missing", file=sys.stderr)
        return 2
    if not token:
        print("SOULSHOUSE_BEARER_TOKEN is missing", file=sys.stderr)
        return 2

    for name in ("after", "through"):
        value = getattr(args, name)
        if value is not None and not value.strip():
            print(f"--{name} was given but empty; refusing rather than saving the whole thread", file=sys.stderr)
            return 2
    query = {key: value for key, value in (("after", args.after), ("through", args.through)) if value is not None}
    url = f"{app_url.rstrip('/')}/api/v1/telegram_conversations/{urllib.parse.quote(args.thread_id, safe='')}"
    if query:
        url += "?" + urllib.parse.urlencode(query)
    request = urllib.request.Request(url, headers={"Authorization": f"Bearer {token}", "Accept": "application/json"})
    try:
        with NO_REDIRECT_OPENER.open(request, timeout=60) as response:
            body = json.load(response)
    except urllib.error.HTTPError as error:
        detail = error.read().decode("utf-8", "replace")[:500]
        print(f"souls.house returned HTTP {error.code}: {detail}", file=sys.stderr)
        return 1
    except (urllib.error.URLError, TimeoutError, json.JSONDecodeError) as error:
        print(f"could not read the thread: {error}", file=sys.stderr)
        return 1

    messages = body.get("conversation", {}).get("transcript", [])
    out = Path(args.out or f"/tmp/telegram-{args.thread_id}.jsonl")
    out.parent.mkdir(parents=True, exist_ok=True)
    with out.open("w", encoding="utf-8") as handle:
        for message in messages:
            handle.write(json.dumps(message, ensure_ascii=False) + "\n")

    span = ""
    if messages:
        span = f", {messages[0].get('timestamp')} to {messages[-1].get('timestamp')}"
    print(f"saved {len(messages)} messages ({out.stat().st_size} bytes{span}) to {out}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
