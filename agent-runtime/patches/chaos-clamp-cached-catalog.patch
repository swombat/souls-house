 #[tokio::test]
+async fn bridge_catalog_refresh_uses_cache_without_native_credentials() {
+    for (name, url) in [
+        ("Anthropic", "https://api.anthropic.com"),
+        (
+            "Gemini",
+            "https://generativelanguage.googleapis.com/v1beta/openai",
+        ),
+    ] {
+        let chaos_home = tempdir().expect("temp dir");
+        let auth = AuthManager::from_auth_for_testing(ChaosAuth::from_api_key("unused"));
+        let provider = ModelProviderInfo {
+            name: name.into(),
+            env_key: Some("CHAOS_TEST_ABSENT_BRIDGE_CATALOG_KEY".into()),
+            ..provider_for(url.into())
+        };
+        let manager =
+            manager_over_own_cache(chaos_home.path().to_path_buf(), auth, provider.clone())
+                .await
+                .with_native_catalog_refresh(false);
+
+        // Both first-run (empty cache) and repeated refreshes must avoid the
+        // native credential lookup, including Anthropic's metadata lookup.
+        manager
+            .refresh_models(RefreshStrategy::Online)
+            .await
+            .unwrap();
+        assert!(
+            manager
+                .list_models(RefreshStrategy::OnlineIfUncached)
+                .await
+                .is_empty()
+        );
+        let model = remote_model("bridge-model", "Bridge model", 1);
+        manager.apply_live_catalog(vec![model.clone()], None).await;
+        let config = ConfigBuilder::default()
+            .chaos_home(chaos_home.path().to_path_buf())
+            .build()
+            .await
+            .expect("test config");
+        assert_eq!(
+            manager.get_model_info("bridge-model", &config).await.slug,
+            model.slug
+        );
+        let rebound = manager.rebound_to("bridge-account", provider).unwrap();
+        assert!(!rebound.native_catalog_refresh);
+
+        // API-key-backed runs still report missing native credentials.
+        let manager = manager.with_native_catalog_refresh(true);
+        assert!(
+            manager
+                .refresh_models(RefreshStrategy::Online)
+                .await
+                .is_err()
+        );
+    }
+}
