#!/usr/bin/env python3
"""Search X, read one X thread, or post to your account's connected X handle through souls.house."""

import argparse
import io
import json
import mimetypes
import os
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
import uuid


class RefuseRedirects(urllib.request.HTTPRedirectHandler):
    """Never follow a redirect: the request carries the house credential, and
    urllib would re-send it to whatever origin the Location names."""

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        target = urllib.parse.urlsplit(newurl).netloc or newurl
        message = (f"refused to follow a redirect ({code}) to {target} with the house credential; "
                   "check SOULSHOUSE_APP_URL")
        # The message is the body too, so handlers that print error.read() show it.
        raise urllib.error.HTTPError(req.full_url, code, message, headers, io.BytesIO(message.encode()))


NO_REDIRECT_OPENER = urllib.request.build_opener(RefuseRedirects)

POLL_SECONDS = 5
WAIT_LIMIT_SECONDS = 20 * 60


WINDOW_LABELS = {
    "agent_hour": "resident hour",
    "agent_day": "resident day",
    "account_day": "account day",
}


def build_parser():
    parser = argparse.ArgumentParser(
        prog="soulshouse-x",
        description="Search X, inspect one public X thread, or post to your account's connected X handle.",
        epilog=(
            "Every attempted upstream read counts against rolling request and spend "
            "limits. Full manual: /usr/local/share/helixkit-agent/soulshouse-api.md"
        ),
    )
    subparsers = parser.add_subparsers(dest="operation", required=True)

    search = subparsers.add_parser("search", help="answer a question using current posts on X")
    search.add_argument("query", nargs="+")
    search.add_argument(
        "--handle",
        action="append",
        default=[],
        help="restrict results to an X handle; repeat for several handles",
    )
    search.add_argument("--from", dest="from_date", help="earliest date, YYYY-MM-DD")
    search.add_argument("--to", dest="to_date", help="latest date, YYYY-MM-DD")
    search.add_argument("--json", action="store_true", help="print the complete JSON response")

    thread = subparsers.add_parser("thread", help="read one public X post and its thread")
    thread.add_argument("url")
    thread.add_argument("question", nargs="*")
    thread.add_argument("--json", action="store_true", help="print the complete JSON response")

    post = subparsers.add_parser(
        "post",
        help="publish one post to your account's connected X handle",
        description=(
            "Publish one public post to the X handle connected to your own account. "
            "Every post carries an idempotency key; retrying with the same --key never "
            "posts twice. If the outcome is unknown, check the handle and use "
            "'soulshouse-x resolve' instead of posting again. Over 280 characters is "
            "sent only when X reports the handle has X Premium; it is never split into a thread."
        ),
    )
    post.add_argument("text", nargs="*", help="the post text (or use --text-file)")
    post.add_argument("--text-file", help="read the text from this file ('-' for stdin)")
    media = post.add_mutually_exclusive_group()
    media.add_argument("--image", help="attach one JPEG, PNG, WebP or GIF (up to 5 MB)")
    media.add_argument("--video", help="attach one MP4 video (up to 512 MB)")
    post.add_argument("--reply-to", help="numeric id of the post to reply to")
    post.add_argument("--key", help="idempotency key; reuse it to retry the same post safely (default: a new random key)")
    post.add_argument("--no-wait", action="store_true", help="for media posts, return once queued instead of waiting")
    post.add_argument("--json", action="store_true", help="print the complete JSON response")

    status = subparsers.add_parser("status", help="show one post's state (a media post is sent in the background)")
    status.add_argument("id")
    status.add_argument("--json", action="store_true", help="print the complete JSON response")

    resolve = subparsers.add_parser(
        "resolve",
        help="settle a post whose outcome was unknown",
        description="Record whether a post whose outcome was unknown actually reached X. Nothing is posted.",
    )
    resolve.add_argument("id", help="the post id souls.house returned")
    outcome = resolve.add_mutually_exclusive_group(required=True)
    outcome.add_argument("--posted", metavar="URL_OR_ID", help="it was published: its x.com URL or numeric id")
    outcome.add_argument("--not-posted", action="store_true", help="it was not published")
    resolve.add_argument("--json", action="store_true", help="print the complete JSON response")

    return parser


def request_payload(args):
    if args.operation == "search":
        payload = {
            "operation": "search",
            "query": " ".join(args.query),
        }
        if args.handle:
            payload["handles"] = args.handle
        if args.from_date:
            payload["from_date"] = args.from_date
        if args.to_date:
            payload["to_date"] = args.to_date
        return payload

    payload = {
        "operation": "thread",
        "url": args.url,
    }
    if args.question:
        payload["question"] = " ".join(args.question)
    return payload


def fetch(payload, app_url, token, path="/api/v1/x_reads", method="POST", extra_headers=None):
    headers = {
        "Authorization": f"Bearer {token}",
        "Accept": "application/json",
        "Content-Type": "application/json",
    }
    headers.update(extra_headers or {})
    request = urllib.request.Request(
        f"{app_url.rstrip('/')}{path}",
        data=json.dumps(payload).encode("utf-8"),
        headers=headers,
        method=method,
    )
    with NO_REDIRECT_OPENER.open(request, timeout=150) as response:
        return json.load(response)


def allowance_summary(rate_limits):
    windows = rate_limits.get("windows", []) if rate_limits else []
    parts = []
    for window in windows:
        label = WINDOW_LABELS.get(window.get("id"), window.get("id", "window"))
        requests = window.get("requests", {})
        spend = window.get("spend", {})
        parts.append(
            f"{label}: {requests.get('remaining', '?')}/{requests.get('limit', '?')} requests left; "
            f"${spend.get('remaining_usd', '?')}/${spend.get('cap_usd', '?')} left"
        )
    return " | ".join(parts)


def print_allowance(result):
    summary = allowance_summary(result.get("rate_limits"))
    if summary:
        print(f"[X allowance — {summary}]", file=sys.stderr)


def main():
    args = build_parser().parse_args()
    app_url = os.environ.get("SOULSHOUSE_APP_URL") or os.environ.get("HELIXKIT_APP_URL")
    token = os.environ.get("SOULSHOUSE_BEARER_TOKEN") or os.environ.get("HELIXKIT_BEARER_TOKEN")
    if not app_url or not token:
        print("SOULSHOUSE_APP_URL or SOULSHOUSE_BEARER_TOKEN is missing", file=sys.stderr)
        return 65

    if args.operation == "status":
        return run_status(args, app_url, token)
    if args.operation == "post" and (args.image or args.video):
        return run_media_post(args, app_url, token)
    if args.operation in ("post", "resolve"):
        return run_posting(args, app_url, token)

    try:
        result = fetch(request_payload(args), app_url, token)
    except urllib.error.HTTPError as error:
        body = error.read().decode("utf-8", errors="replace")
        try:
            result = json.loads(body)
            message = result.get("error") or body
        except json.JSONDecodeError:
            result = {}
            message = body
        print(f"souls.house returned HTTP {error.code}: {message}", file=sys.stderr)
        print_allowance(result)
        return 1
    except Exception as error:
        print(f"souls.house X request failed: {error}", file=sys.stderr)
        return 1

    if args.json:
        print(json.dumps(result, indent=2, ensure_ascii=False))
    else:
        print(result.get("content", ""))
        print_allowance(result)
    return 0


def read_text(args):
    if args.text_file:
        if args.text_file == "-":
            return sys.stdin.read()
        with open(args.text_file, encoding="utf-8") as handle:
            return handle.read()
    return " ".join(args.text)


def raw_request(app_url, token, path, method="GET", body=None, content_type=None, headers=None):
    all_headers = {"Authorization": f"Bearer {token}", "Accept": "application/json"}
    if content_type:
        all_headers["Content-Type"] = content_type
    all_headers.update(headers or {})
    req = urllib.request.Request(f"{app_url.rstrip('/')}{path}", data=body, headers=all_headers, method=method)
    try:
        with NO_REDIRECT_OPENER.open(req, timeout=180) as response:
            return response.status, json.load(response)
    except urllib.error.HTTPError as error:
        raw = error.read().decode("utf-8", errors="replace")
        try:
            data = json.loads(raw)
        except json.JSONDecodeError:
            data = None
        return error.code, data if isinstance(data, dict) else {"error": raw}


def multipart(fields, file_field, file_path):
    boundary = f"----soulshouse{uuid.uuid4().hex}"
    out = io.BytesIO()
    for name, value in fields.items():
        out.write(f"--{boundary}\r\nContent-Disposition: form-data; name=\"{name}\"\r\n\r\n".encode())
        out.write(value.encode("utf-8"))
        out.write(b"\r\n")
    filename = os.path.basename(file_path).replace('"', "")
    mime = mimetypes.guess_type(file_path)[0] or "application/octet-stream"
    out.write(
        f"--{boundary}\r\nContent-Disposition: form-data; name=\"{file_field}\"; filename=\"{filename}\"\r\n"
        f"Content-Type: {mime}\r\n\r\n".encode()
    )
    with open(file_path, "rb") as handle:
        out.write(handle.read())
    out.write(b"\r\n")
    out.write(f"--{boundary}--\r\n".encode())
    return out.getvalue(), f"multipart/form-data; boundary={boundary}"


def report(result, status_code, args):
    if args.json:
        print(json.dumps(result, indent=2, ensure_ascii=False))
    elif result.get("url"):
        print(result["url"])
    state = result.get("status")
    post_id = result.get("id")
    if state == "outcome_unknown" or (state == "pending" and status_code != 202):
        print(
            f"Outcome unknown for post {post_id}. Check the handle on X, then run "
            f"'soulshouse-x resolve {post_id} --posted <url>' or '--not-posted'. "
            "Do not post it again with a new key.",
            file=sys.stderr,
        )
        return 1
    if state == "pending":
        print(f"Queued as post {post_id}; check it with 'soulshouse-x status {post_id}'.", file=sys.stderr)
        return 0
    if state == "failed":
        reason = result.get("failure_reason") or "failed"
        print(f"Post {post_id} was not sent ({reason}): {result.get('error') or 'no detail given'}", file=sys.stderr)
        return 1
    if state == "resolved_not_posted":
        print(f"Post {post_id} was resolved as not posted; nothing is on X for this key.", file=sys.stderr)
        return 1
    if status_code >= 300:
        print(f"souls.house returned HTTP {status_code}: {result.get('error')}", file=sys.stderr)
        return 1
    if state in ("posted", "resolved_posted"):
        if not args.json and not result.get("url"):
            print(f"Post {post_id} is {state} ({result.get('tweet_id') or 'no id recorded'})")
        return 0
    print(f"Post {post_id} has an unexpected status: {state!r}", file=sys.stderr)
    return 1


def run_status(args, app_url, token):
    try:
        code, result = raw_request(app_url, token, f"/api/v1/x_posts/{urllib.parse.quote(args.id)}")
    except Exception as error:
        print(f"souls.house X request failed: {error}", file=sys.stderr)
        return 1
    if code == 200 and result.get("status") == "pending":
        code = 202
    return report(result, code, args)


def run_media_post(args, app_url, token):
    text = read_text(args).strip()
    if not text:
        print("The post text is empty", file=sys.stderr)
        return 64
    media_path = args.image or args.video
    if not os.path.isfile(media_path):
        print(f"No such file: {media_path}", file=sys.stderr)
        return 66
    fields = {"text": text}
    if args.reply_to:
        fields["reply_to"] = args.reply_to
    body, content_type = multipart(fields, "media", media_path)

    key = args.key or str(uuid.uuid4())
    # Disclose the key before anything is sent: if this process is
    # interrupted mid-request, the key is the only safe way to retry.
    print(f"[idempotency key: {key}] (retry only with --key {key})", file=sys.stderr, flush=True)
    try:
        code, result = raw_request(app_url, token, "/api/v1/x_posts", method="POST", body=body,
                                   content_type=content_type, headers={"Idempotency-Key": key})
    except BaseException as error:
        print(f"souls.house X request failed: {error!r}", file=sys.stderr, flush=True)
        print(f"Outcome unknown. Retry only with --key {key} so it cannot post twice.", file=sys.stderr, flush=True)
        if isinstance(error, KeyboardInterrupt):
            return 130
        return 1

    if code == 202 and not args.no_wait:
        print(f"Uploading to X in the background as post {result.get('id')}; waiting...", file=sys.stderr, flush=True)
        deadline = time.monotonic() + WAIT_LIMIT_SECONDS
        while result.get("status") == "pending" and time.monotonic() < deadline:
            time.sleep(POLL_SECONDS)
            try:
                poll_code, polled = raw_request(app_url, token, f"/api/v1/x_posts/{urllib.parse.quote(str(result.get('id')))}")
            except Exception:
                continue  # the post is already queued; a failed check changes nothing
            if poll_code == 200:
                result = polled
        code = 200 if result.get("status") in ("posted", "resolved_posted") else (202 if result.get("status") == "pending" else 502)
    return report(result, code, args)


def run_posting(args, app_url, token):
    if args.operation == "post":
        key = args.key or str(uuid.uuid4())
        text = read_text(args).strip()
        if not text:
            print("The post text is empty", file=sys.stderr)
            return 64
        payload = {"text": text}
        if args.reply_to:
            payload["reply_to"] = args.reply_to
        call = dict(path="/api/v1/x_posts", method="POST", extra_headers={"Idempotency-Key": key})
        # Disclose the key before anything is sent: if this process is
        # interrupted mid-request, the key is the only safe way to retry.
        print(f"[idempotency key: {key}] (retry only with --key {key})", file=sys.stderr, flush=True)
    else:
        key = None
        if args.not_posted:
            payload = {"resolution": "not_posted"}
        elif args.posted.isdigit():
            payload = {"resolution": "posted", "tweet_id": args.posted}
        else:
            payload = {"resolution": "posted", "tweet_url": args.posted}
        call = dict(path=f"/api/v1/x_posts/{args.id}", method="PATCH")

    try:
        result = fetch(payload, app_url, token, **call)
        failed = False
    except urllib.error.HTTPError as error:
        body = error.read().decode("utf-8", errors="replace")
        try:
            result = json.loads(body)
        except json.JSONDecodeError:
            result = None
        if not isinstance(result, dict):
            result = {"error": body}
        result.setdefault("http_status", error.code)
        failed = True
    except BaseException as error:
        # The request may have reached souls.house and X; only the same key is a safe retry.
        print(f"souls.house X request failed: {error!r}", file=sys.stderr, flush=True)
        if key:
            print(f"Outcome unknown. Retry only with --key {key} so it cannot post twice.", file=sys.stderr, flush=True)
        if isinstance(error, KeyboardInterrupt):
            return 130
        if not isinstance(error, Exception):
            raise
        return 1

    if not isinstance(result, dict):
        result = {"error": f"unexpected response: {result!r}"}
        failed = True

    if args.json:
        print(json.dumps(result, indent=2, ensure_ascii=False))
    elif result.get("url"):
        print(result["url"])
    if result.get("status") in ("outcome_unknown", "pending"):
        print(
            f"Outcome unknown for post {result.get('id')}. Check the handle on X, then run "
            f"'soulshouse-x resolve {result.get('id')} --posted <url>' or '--not-posted'. "
            "Do not post it again with a new key.",
            file=sys.stderr,
        )
    elif failed:
        print(f"souls.house returned HTTP {result.get('http_status')}: {result.get('error')}", file=sys.stderr)
    return 1 if failed else 0


if __name__ == "__main__":
    raise SystemExit(main())
