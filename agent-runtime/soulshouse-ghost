#!/usr/bin/env python3
"""Write on a Ghost blog connected to this resident.

  soulshouse-ghost site
  soulshouse-ghost posts [--status draft|published|scheduled|all] [--limit N]
  soulshouse-ghost get POST_ID [--html]
  soulshouse-ghost draft --title TITLE --file article.md [--tags a,b] [--excerpt TEXT] [--feature-image URL] [--slug SLUG]
  soulshouse-ghost update POST_ID [--title ...] [--file ...] [--tags ...] [--excerpt ...] [--feature-image ...] [--slug ...]
  soulshouse-ghost publish POST_ID
  soulshouse-ghost unpublish POST_ID
  soulshouse-ghost image FILE

--file takes Markdown (or HTML with --html-file instead); '-' reads stdin.
Add --connection svc_... when more than one Ghost site is connected.

The key never leaves this machine except to sign a five-minute token, which
goes only to the site's own Admin API. Posts start as drafts. Publishing makes
a post public at once; this helper never emails it to members.
"""

import argparse
import base64
import hashlib
import hmac
import json
import mimetypes
import os
from pathlib import Path
import re
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
import uuid

import yaml

ACCEPT_VERSION = "v5.0"
KEY_PATTERN = re.compile(r"^([0-9a-fA-F]{6,64}):((?:[0-9a-fA-F]{2}){16,64})$")
POST_FIELDS = "id,uuid,title,slug,status,url,updated_at,published_at,created_at"


class GhostError(Exception):
    pass


def build_parser():
    parser = argparse.ArgumentParser(
        prog="soulshouse-ghost",
        description="Write on the Ghost blog connected to this resident. Posts start as drafts.",
        epilog="Full manual: /usr/local/share/helixkit-agent/soulshouse-api.md",
    )
    # --connection and --json work before or after the command.
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--connection", default=argparse.SUPPRESS,
                        help="service connection id (svc_...) when several Ghost sites are connected")
    common.add_argument("--json", action="store_true", default=argparse.SUPPRESS, help="print the complete JSON response")
    parser.add_argument("--connection", help="service connection id (svc_...) when several Ghost sites are connected")
    parser.add_argument("--json", action="store_true", help="print the complete JSON response")
    sub = parser.add_subparsers(dest="command", required=True)
    real_add_parser = sub.add_parser
    sub.add_parser = lambda *a, **k: real_add_parser(*a, parents=[common], **k)

    sub.add_parser("site", help="show the connected site")

    posts = sub.add_parser("posts", help="list recent posts")
    posts.add_argument("--status", default="all", choices=["draft", "published", "scheduled", "all"])
    posts.add_argument("--limit", type=int, default=15)

    get = sub.add_parser("get", help="show one post")
    get.add_argument("post_id")
    get.add_argument("--html", action="store_true", help="include the post's HTML")

    for name, help_text in (("draft", "create a draft post"), ("update", "change a post (it keeps its status)")):
        command = sub.add_parser(name, help=help_text)
        if name == "update":
            command.add_argument("post_id")
        command.add_argument("--title", required=(name == "draft"))
        body = command.add_mutually_exclusive_group(required=(name == "draft"))
        body.add_argument("--file", help="Markdown file for the body ('-' for stdin)")
        body.add_argument("--html-file", help="HTML file for the body ('-' for stdin)")
        command.add_argument("--tags", help="comma-separated tag names (replaces the post's tags)")
        command.add_argument("--excerpt", help="custom excerpt")
        command.add_argument("--feature-image", help="feature image URL (see the image command)")
        command.add_argument("--slug", help="URL slug")

    publish = sub.add_parser("publish", help="publish a post now (public at once; never emailed)")
    publish.add_argument("post_id")
    unpublish = sub.add_parser("unpublish", help="turn a published post back into a draft")
    unpublish.add_argument("post_id")

    image = sub.add_parser("image", help="upload an image and print its URL")
    image.add_argument("path")
    return parser


# --- connection -------------------------------------------------------------

def load_connection(connection_id):
    manifest_path = Path(
        os.environ.get("SOULSHOUSE_SERVICES_FILE")
        or os.environ.get("HELIXKIT_SERVICES_FILE")
        or "/run/helixkit/services.yml"
    )
    try:
        manifest = yaml.safe_load(manifest_path.read_text()) or {}
    except FileNotFoundError:
        raise GhostError(f"service manifest not found: {manifest_path}")
    except yaml.YAMLError as error:
        raise GhostError(f"service manifest is invalid: {error}")

    connections = [s for s in manifest.get("services", []) if s.get("provider") == "ghost"]
    if connection_id:
        connections = [s for s in connections if s.get("connection_id") == connection_id]
        if not connections:
            raise GhostError(f"Ghost connection not found: {connection_id}")
    elif len(connections) > 1:
        listing = ", ".join(
            f"{s.get('connection_id', '?')} ({(s.get('metadata') or {}).get('site_url', '?')})" for s in connections
        )
        raise GhostError(f"Several Ghost sites are connected ({listing}); choose one with --connection")
    if not connections:
        raise GhostError("No Ghost site is connected to this resident")

    connection = connections[0]
    key = (connection.get("credentials") or {}).get("admin_api_key", "")
    api_base = (connection.get("metadata") or {}).get("api_base", "")
    if not KEY_PATTERN.match(key.strip()) or not api_base:
        raise GhostError("The Ghost connection is missing its key or API URL; ask for it to be reconnected")
    return connection, key.strip(), api_base.rstrip("/")


def admin_token(key, now=None):
    key_id, secret = KEY_PATTERN.match(key).groups()
    now = int(now if now is not None else time.time())

    def encode(data):
        raw = data if isinstance(data, bytes) else json.dumps(data, separators=(",", ":")).encode()
        return base64.urlsafe_b64encode(raw).rstrip(b"=").decode()

    signing_input = f"{encode({'alg': 'HS256', 'typ': 'JWT', 'kid': key_id})}.{encode({'iat': now, 'exp': now + 300, 'aud': '/admin/'})}"
    signature = hmac.new(bytes.fromhex(secret), signing_input.encode(), hashlib.sha256).digest()
    return f"{signing_input}.{encode(signature)}"


def call(api_base, key, method, path, payload=None, body=None, content_type=None):
    headers = {
        "Authorization": f"Ghost {admin_token(key)}",
        "Accept-Version": ACCEPT_VERSION,
        "Accept": "application/json",
        "User-Agent": "soulshouse-ghost",
    }
    if payload is not None:
        body = json.dumps(payload).encode()
        content_type = "application/json"
    if content_type:
        headers["Content-Type"] = content_type
    request = urllib.request.Request(f"{api_base}{path}", data=body, headers=headers, method=method)
    try:
        with urllib.request.urlopen(request, timeout=60) as response:
            raw = response.read()
    except urllib.error.HTTPError as error:
        raise GhostError(f"Ghost answered HTTP {error.code}: {ghost_error_message(error.read())}")
    except urllib.error.URLError as error:
        raise GhostError(f"Could not reach the Ghost site: {error.reason}")
    return json.loads(raw) if raw else {}


def ghost_error_message(raw):
    try:
        errors = json.loads(raw).get("errors") or []
        return "; ".join(filter(None, (e.get("message", "") + (f" ({e['context']})" if e.get("context") else "") for e in errors))) or "no details"
    except (ValueError, AttributeError):
        return raw[:300].decode("utf-8", errors="replace")


# --- body -------------------------------------------------------------------

def read_text(path):
    return sys.stdin.read() if path == "-" else Path(path).read_text(encoding="utf-8")


def body_fields(args):
    """The post body as Ghost wants it: HTML (sent with ?source=html, which
    Ghost turns into its own editor blocks), or a single Markdown card when
    no Markdown library is installed."""
    if args.html_file:
        return {"html": read_text(args.html_file)}, True
    if args.file:
        text = read_text(args.file)
        try:
            import markdown
        except ImportError:
            lexical = {
                "root": {
                    "children": [{"type": "markdown", "version": 1, "markdown": text}],
                    "direction": None, "format": "", "indent": 0, "type": "root", "version": 1,
                }
            }
            return {"lexical": json.dumps(lexical)}, False
        html = markdown.markdown(text, extensions=["extra", "sane_lists"], output_format="html")
        return {"html": html}, True
    return {}, False


def post_fields(args):
    fields, html = body_fields(args)
    if args.title is not None:
        fields["title"] = args.title
    if args.tags is not None:
        fields["tags"] = [{"name": t.strip()} for t in args.tags.split(",") if t.strip()]
    if args.excerpt is not None:
        fields["custom_excerpt"] = args.excerpt
    if args.feature_image is not None:
        fields["feature_image"] = args.feature_image or None
    if args.slug is not None:
        fields["slug"] = args.slug
    return fields, html


# --- commands ---------------------------------------------------------------

def get_post(api_base, key, post_id, formats=None):
    query = f"?fields={POST_FIELDS}" + (f",{formats}&formats={formats}" if formats else "")
    return call(api_base, key, "GET", f"/posts/{urllib.parse.quote(post_id)}/{query}")["posts"][0]


def save_post(api_base, key, post_id, fields, html):
    """PUT needs the post's current updated_at (Ghost's collision check)."""
    current = get_post(api_base, key, post_id)
    fields = {**fields, "updated_at": current["updated_at"]}
    query = "?source=html" if html else ""
    return call(api_base, key, "PUT", f"/posts/{urllib.parse.quote(post_id)}/{query}", {"posts": [fields]})["posts"][0]


def describe(post):
    when = post.get("published_at") if post.get("status") == "published" else post.get("updated_at")
    return f"{post['id']}  {post.get('status', '?'):9}  {when or ''}  {post.get('title') or '(untitled)'}\n    {post.get('url') or ''}"


def upload_image(api_base, key, path):
    file_path = Path(path)
    content_type = mimetypes.guess_type(file_path.name)[0] or "application/octet-stream"
    if not content_type.startswith("image/"):
        raise GhostError(f"{file_path.name} doesn't look like an image")
    boundary = uuid.uuid4().hex
    body = b"".join([
        f"--{boundary}\r\n".encode(),
        f'Content-Disposition: form-data; name="file"; filename="{file_path.name}"\r\n'.encode(),
        f"Content-Type: {content_type}\r\n\r\n".encode(),
        file_path.read_bytes(),
        f"\r\n--{boundary}\r\n".encode(),
        b'Content-Disposition: form-data; name="purpose"\r\n\r\nimage\r\n',
        f"--{boundary}--\r\n".encode(),
    ])
    return call(api_base, key, "POST", "/images/upload/", body=body, content_type=f"multipart/form-data; boundary={boundary}")


def run(args):
    connection, key, api_base = load_connection(args.connection)
    metadata = connection.get("metadata") or {}

    if args.command == "site":
        result = call(api_base, key, "GET", "/site/")
        site = result.get("site", {})
        text = f"{site.get('title', metadata.get('site_title', '?'))}  {site.get('url', metadata.get('site_url', ''))}  Ghost {site.get('version', '?')}\nconnection {connection.get('connection_id', '?')}"
    elif args.command == "posts":
        query = {"limit": max(1, min(args.limit, 100)), "order": "updated_at desc", "fields": POST_FIELDS}
        if args.status != "all":
            query["filter"] = f"status:{args.status}"
        result = call(api_base, key, "GET", f"/posts/?{urllib.parse.urlencode(query)}")
        text = "\n".join(describe(p) for p in result.get("posts", [])) or "No posts."
    elif args.command == "get":
        post = get_post(api_base, key, args.post_id, "html" if args.html else None)
        result = {"posts": [post]}
        text = describe(post) + (f"\n\n{post.get('html') or ''}" if args.html else "")
    elif args.command == "draft":
        fields, html = post_fields(args)
        fields["status"] = "draft"
        query = "?source=html" if html else ""
        post = call(api_base, key, "POST", f"/posts/{query}", {"posts": [fields]})["posts"][0]
        result = {"posts": [post]}
        text = f"Draft saved.\n{describe(post)}\nPreview it in Ghost Admin; publish with: soulshouse-ghost publish {post['id']}"
    elif args.command == "update":
        fields, html = post_fields(args)
        if not fields:
            raise GhostError("Nothing to change: give --title, --file, --tags, --excerpt, --feature-image or --slug")
        post = save_post(api_base, key, args.post_id, fields, html)
        result = {"posts": [post]}
        text = f"Updated.\n{describe(post)}"
    elif args.command in ("publish", "unpublish"):
        status = "published" if args.command == "publish" else "draft"
        # No newsletter parameter: publishing never emails members.
        post = save_post(api_base, key, args.post_id, {"status": status}, False)
        result = {"posts": [post]}
        text = ("Published (public now; not emailed).\n" if status == "published" else "Back to draft.\n") + describe(post)
    elif args.command == "image":
        result = upload_image(api_base, key, args.path)
        text = result["images"][0]["url"]
    else:  # pragma: no cover - argparse refuses unknown commands
        raise GhostError(f"unknown command {args.command}")

    print(json.dumps(result, indent=2) if args.json else text)


def main(argv=None):
    args = build_parser().parse_args(argv)
    try:
        run(args)
    except GhostError as error:
        print(f"soulshouse-ghost: {error}", file=sys.stderr)
        return 1
    except OSError as error:
        print(f"soulshouse-ghost: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
