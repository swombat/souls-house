#!/usr/bin/env python3
"""
Join this resident to its account's tailnet and reach machines there over SSH.

Usage:
  soulshouse-tailnet status [--json]   whether this resident is on the tailnet,
                                       and which configured machines answer
  soulshouse-tailnet up                start the daemon, join if needed, write
                                       the SSH aliases (idempotent)
  soulshouse-tailnet pubkey            the SSH public key a machine's owner
                                       adds to authorized_keys
  soulshouse-tailnet down              disconnect, staying joined
  soulshouse-tailnet boot              what the container runs at start: `up`
                                       when granted, `forget` when not
  soulshouse-tailnet forget            log this node out and delete its state
                                       (the SSH key is kept)

After `up`, each machine in the Tailscale integration is `ssh <alias>`.

tailscaled runs in userspace networking mode as the agent user; its node state
lives in ~/state/tailscale so the resident stays the same node across rebuilds.
The node state is bound to the integration that created it: if a different
Tailscale integration is granted later, the old node logs out first. The auth
key is read from the runtime service manifest and only spent when the node is
not yet logged in. It is passed to tailscale through a 0600 file, never on a
command line. The resident's SSH key lives separately in ~/state/tailnet-ssh, so
disabling and re-enabling the integration doesn't invalidate the machines that
already trust it.
"""

from __future__ import annotations

import contextlib
import fcntl
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import time

import yaml


SERVICES_FILE = Path(os.environ.get("HELIXKIT_SERVICES_FILE", "/run/helixkit/services.yml"))
STATE_DIR = Path(os.environ.get("SOULSHOUSE_TAILNET_STATE", Path.home() / "state" / "tailscale"))
SSH_DIR = Path(os.environ.get("SOULSHOUSE_TAILNET_SSH_DIR", Path.home() / "state" / "tailnet-ssh"))
SSH_CONFIG = Path(os.environ.get("SOULSHOUSE_TAILNET_SSH_CONFIG", Path.home() / ".ssh" / "config"))
TAILSCALE = os.environ.get("SOULSHOUSE_TAILSCALE_BINARY", "tailscale")
TAILSCALED = os.environ.get("SOULSHOUSE_TAILSCALED_BINARY", "tailscaled")
DAEMON_WAIT_SECONDS = float(os.environ.get("SOULSHOUSE_TAILNET_DAEMON_WAIT", "15"))

BEGIN_MARK = "# BEGIN soulshouse-tailnet (managed; edits here are overwritten)"
END_MARK = "# END soulshouse-tailnet"

# Same rules as Services::TailscaleAdapter. Checked again here because these
# values are written into ssh_config, where ProxyCommand expands %h.
ALIAS_PATTERN = re.compile(r"\A[a-z0-9][a-z0-9_-]{0,31}\Z")
USER_PATTERN = re.compile(r"\A[a-z_][a-z0-9_.-]{0,31}\Z", re.I)
MACHINE_PATTERN = re.compile(r"\A[A-Za-z0-9](?:[A-Za-z0-9.-]{0,251}[A-Za-z0-9])?\Z")

KEY_REJECTED_HINT = (
    "Tailscale rejected the auth key. Reusable auth keys expire (at most 90 days) even though nodes "
    "already joined with them keep working; ask the account admin for a fresh tagged key."
)


class TailnetError(Exception):
    pass


def main(argv: list[str]) -> int:
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0 if argv else 64

    command, rest = argv[0], argv[1:]
    try:
        if command == "status":
            return status(as_json="--json" in rest)
        if command == "up":
            return up()
        if command == "pubkey":
            return pubkey()
        if command == "down":
            return down()
        if command == "boot":
            return boot()
        if command == "forget":
            return forget()
    except TailnetError as error:
        print(f"soulshouse-tailnet: {error}", file=sys.stderr)
        return 1

    print(f"soulshouse-tailnet: unknown command {command!r}\n", file=sys.stderr)
    print(__doc__.strip(), file=sys.stderr)
    return 64


# ── manifest ───────────────────────────────────────────────────────────────

def tailnet_entries() -> list[dict]:
    try:
        manifest = yaml.safe_load(SERVICES_FILE.read_text()) or {}
    except FileNotFoundError:
        return []
    return [s for s in manifest.get("services") or [] if s.get("provider") == "tailscale"]


def tailnet_entry() -> dict | None:
    entries = tailnet_entries()
    if len(entries) > 1:
        labels = ", ".join(str(e.get("label") or e.get("connection_id")) for e in entries)
        raise TailnetError(
            f"{len(entries)} Tailscale integrations are granted to this resident ({labels}); "
            "a resident is one node on one tailnet, so disable all but one"
        )
    return entries[0] if entries else None


def require_entry() -> dict:
    entry = tailnet_entry()
    if entry is None:
        raise TailnetError("no Tailscale integration is granted to this resident")
    if not (entry.get("credentials") or {}).get("auth_key"):
        raise TailnetError("the Tailscale integration has no auth key")
    return entry


def hosts_of(entry: dict) -> list[dict]:
    hosts = list((entry.get("metadata") or {}).get("hosts") or [])
    for host in hosts:
        valid = (
            ALIAS_PATTERN.match(str(host.get("alias", "")))
            and MACHINE_PATTERN.match(str(host.get("machine", "")))
            and (host.get("user") is None or USER_PATTERN.match(str(host["user"])))
        )
        if not valid:
            raise TailnetError(f"refusing a malformed host entry from the manifest: {host!r}")
    return hosts


# ── daemon ─────────────────────────────────────────────────────────────────

def socket_path() -> Path:
    return STATE_DIR / "tailscaled.sock"


def cli(*args: str, timeout: float = 30) -> subprocess.CompletedProcess:
    return subprocess.run(
        [TAILSCALE, f"--socket={socket_path()}", *args],
        capture_output=True, text=True, timeout=timeout,
    )


def backend_status() -> dict | None:
    if not socket_path().exists():
        return None
    try:
        result = cli("status", "--json", timeout=10)
    except (subprocess.TimeoutExpired, FileNotFoundError):
        return None
    if not result.stdout.strip():
        return None
    try:
        return json.loads(result.stdout)
    except json.JSONDecodeError:
        return None


def ensure_daemon() -> dict:
    current = backend_status()
    if current is not None:
        return current

    STATE_DIR.mkdir(parents=True, exist_ok=True)
    STATE_DIR.chmod(0o700)
    with contextlib.suppress(FileNotFoundError):
        socket_path().unlink()
    log = open(STATE_DIR / "tailscaled.log", "ab")
    try:
        daemon = subprocess.Popen(
            [
                TAILSCALED,
                "--tun=userspace-networking",
                f"--statedir={STATE_DIR}",
                f"--socket={socket_path()}",
            ],
            stdin=subprocess.DEVNULL, stdout=log, stderr=log,
            start_new_session=True,
        )
    except FileNotFoundError as error:
        raise TailnetError(f"cannot start tailscaled: {error}") from error
    finally:
        log.close()
    (STATE_DIR / "tailscaled.pid").write_text(f"{daemon.pid}\n")

    deadline = time.monotonic() + DAEMON_WAIT_SECONDS
    while time.monotonic() < deadline:
        current = backend_status()
        if current is not None:
            return current
        time.sleep(0.2)
    raise TailnetError(f"tailscaled did not answer within {DAEMON_WAIT_SECONDS:g}s (log: {STATE_DIR / 'tailscaled.log'})")


def node_hostname() -> str:
    slug = re.sub(r"[^a-z0-9-]+", "-", os.environ.get("AGENT_SLUG", "resident").lower()).strip("-") or "resident"
    return f"soulshouse-{slug}"[:63].rstrip("-")


@contextlib.contextmanager
def state_lock():
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    STATE_DIR.chmod(0o700)
    with open(STATE_DIR / ".lock", "w") as handle:
        fcntl.flock(handle, fcntl.LOCK_EX)
        yield


# ── commands ───────────────────────────────────────────────────────────────

def up() -> int:
    entry = require_entry()
    hosts = hosts_of(entry)
    with state_lock():
        bound_to = bound_connection()
        if bound_to is not None and bound_to != entry.get("connection_id"):
            # The node belongs to an integration that is no longer granted.
            # Leave that tailnet before joining with the new key.
            leave_tailnet()
        state = ensure_daemon()
        backend = state.get("BackendState")
        if backend != "Running":
            args = ["up", f"--hostname={node_hostname()}", "--accept-dns=false", "--timeout=60s"]
            key_file = None
            if backend in (None, "NeedsLogin", "NoState"):
                key_file = STATE_DIR / ".auth-key"
                fd = os.open(key_file, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
                with os.fdopen(fd, "w") as handle:
                    handle.write(entry["credentials"]["auth_key"])
                args.append(f"--auth-key=file:{key_file}")
            try:
                result = cli(*args, timeout=90)
            finally:
                if key_file is not None:
                    with contextlib.suppress(FileNotFoundError):
                        key_file.unlink()
            if result.returncode != 0:
                detail = (result.stderr or result.stdout).strip().splitlines()
                message = detail[-1] if detail else f"exit {result.returncode}"
                if key_file is not None and "invalid key" in message.lower():
                    message += f"\n{KEY_REJECTED_HINT}"
                raise TailnetError("tailscale up failed: " + message)
        (STATE_DIR / "connection").write_text(f"{entry.get('connection_id')}\n")
        ensure_ssh_key()
        write_ssh_config(hosts)

    print(f"on the tailnet as {node_hostname()}")
    for host in hosts:
        print(f"  ssh {host['alias']}  →  {ssh_target(host)}")
    return 0


def bound_connection() -> str | None:
    """The integration this node state was joined with, or None if no node state.

    State without a record (from a build before binding existed) counts as bound
    to nothing, so it is left before rejoining rather than trusted."""
    if not (STATE_DIR / "tailscaled.state").exists():
        return None
    try:
        return (STATE_DIR / "connection").read_text().strip() or "unrecorded"
    except FileNotFoundError:
        return "unrecorded"


def down() -> int:
    if backend_status() is None:
        print("tailscaled is not running")
        return 0
    result = cli("down")
    if result.returncode != 0:
        raise TailnetError("tailscale down failed: " + result.stderr.strip())
    print("disconnected (still joined; `soulshouse-tailnet up` reconnects)")
    return 0


def boot() -> int:
    if tailnet_entries():
        return up()
    return forget()


def forget() -> int:
    # Remove the SSH aliases first: whatever happens to the logout, nothing in
    # this resident should route to those machines any more.
    write_ssh_config([])
    if not STATE_DIR.exists():
        return 0
    had_node = (STATE_DIR / "tailscaled.state").exists()
    with state_lock():
        leave_tailnet()
    if had_node:
        print("left the tailnet and removed this resident's node state")
    return 0


def leave_tailnet() -> None:
    """Log the saved node out, stop its daemon, delete the node state.

    Must be called with the state lock held. If the logout can't be confirmed,
    the daemon is stopped but the state is kept so the next boot retries; the
    node may still be on the tailnet, and the error says so."""
    if (STATE_DIR / "tailscaled.state").exists():
        try:
            state = ensure_daemon()
            if state.get("BackendState") not in ("NeedsLogin", "NoState"):
                result = cli("logout", timeout=30)
                if result.returncode != 0:
                    raise TailnetError("tailscale logout failed: " + (result.stderr or result.stdout).strip())
        except (TailnetError, subprocess.TimeoutExpired) as error:
            stop_daemon()
            raise TailnetError(
                f"could not confirm logout ({error}). The daemon is stopped and the node state is kept "
                "so the next boot retries. The node may still be listed on the tailnet: remove it in the "
                "Tailscale admin console if access must end now."
            ) from error
    stop_daemon()
    for child in STATE_DIR.iterdir():
        if child.name == ".lock":
            continue
        if child.is_dir() and not child.is_symlink():
            shutil.rmtree(child, ignore_errors=True)
        else:
            child.unlink(missing_ok=True)


def stop_daemon() -> None:
    # Only the daemon this helper started, by its recorded PID and only if that
    # PID is still a tailscaled on our socket. Never a pattern match: a pattern
    # also matches whatever shell happens to mention the socket path.
    try:
        pid = int((STATE_DIR / "tailscaled.pid").read_text().strip())
        cmdline = Path(f"/proc/{pid}/cmdline").read_bytes().split(b"\0")
    except (FileNotFoundError, ValueError):
        return
    if not any(arg.endswith(b"tailscaled") for arg in cmdline[:2]) or f"--socket={socket_path()}".encode() not in cmdline:
        return
    with contextlib.suppress(ProcessLookupError):
        os.kill(pid, 15)
    deadline = time.monotonic() + 5
    while time.monotonic() < deadline and Path(f"/proc/{pid}").exists():
        time.sleep(0.1)


def pubkey() -> int:
    require_entry()
    with state_lock():
        key = ensure_ssh_key()
    print(Path(f"{key}.pub").read_text().strip())
    return 0


def status(as_json: bool) -> int:
    entry = tailnet_entry()
    state = backend_status()
    report = {
        "granted": entry is not None,
        "daemon": state is not None,
        "backend_state": (state or {}).get("BackendState"),
        "node": None,
        "addresses": [],
        "hosts": [],
    }
    me = (state or {}).get("Self") or {}
    if me:
        report["node"] = (me.get("DNSName") or me.get("HostName") or "").rstrip(".")
        report["addresses"] = me.get("TailscaleIPs") or []
    for host in hosts_of(entry or {}):
        reachable = None
        if report["backend_state"] == "Running":
            with contextlib.suppress(subprocess.TimeoutExpired):
                reachable = cli("ping", "-c", "1", "--timeout=3s", host["machine"], timeout=10).returncode == 0
        report["hosts"].append({"alias": host["alias"], "target": ssh_target(host), "reachable": reachable})

    if as_json:
        print(json.dumps(report, indent=2))
        return 0

    if not report["granted"]:
        print("No Tailscale integration is granted to this resident.")
    if not report["daemon"]:
        print("tailscaled is not running." + ("  Run: soulshouse-tailnet up" if report["granted"] else ""))
        return 0 if report["granted"] else 3
    print(f"state: {report['backend_state']}")
    if report["node"]:
        print(f"node:  {report['node']}  {' '.join(report['addresses'])}")
    for host in report["hosts"]:
        answer = {True: "answers", False: "no answer", None: "not checked"}[host["reachable"]]
        print(f"  ssh {host['alias']}  →  {host['target']}  ({answer})")
    return 0


# ── ssh ────────────────────────────────────────────────────────────────────

def ssh_dir() -> Path:
    return SSH_DIR


def ensure_ssh_key() -> Path:
    key = ssh_dir() / "id_ed25519"
    if not key.exists():
        ssh_dir().mkdir(parents=True, exist_ok=True)
        ssh_dir().chmod(0o700)
        subprocess.run(
            ["ssh-keygen", "-q", "-t", "ed25519", "-N", "", "-C", node_hostname(), "-f", str(key)],
            check=True,
        )
    return key


def ssh_target(host: dict) -> str:
    return f"{host['user']}@{host['machine']}" if host.get("user") else host["machine"]


def managed_block(hosts: list[dict]) -> str:
    if not hosts:
        return ""
    lines = [BEGIN_MARK]
    for host in hosts:
        lines += [
            f"Host {host['alias']}",
            f"    HostName {host['machine']}",
            *([f"    User {host['user']}"] if host.get("user") else []),
            f"    ProxyCommand {TAILSCALE} --socket={socket_path()} nc %h %p",
            f"    IdentityFile {ssh_dir() / 'id_ed25519'}",
            "    IdentitiesOnly yes",
            f"    UserKnownHostsFile {ssh_dir() / 'known_hosts'}",
            "    StrictHostKeyChecking accept-new",
            "    ServerAliveInterval 30",
            "",
        ]
    # Return to the global scope so anything the resident wrote below this
    # block keeps applying to every host, as it did before the block existed.
    lines.append("Match all")
    lines.append(END_MARK)
    return "\n".join(lines) + "\n"


def write_ssh_config(hosts: list[dict]) -> None:
    try:
        existing = SSH_CONFIG.read_text()
    except FileNotFoundError:
        existing = ""
    pattern = re.compile(rf"\n?{re.escape(BEGIN_MARK)}.*?{re.escape(END_MARK)}\n?", re.S)
    unmanaged = pattern.sub("\n", existing).strip("\n")
    block = managed_block(hosts)
    # Our Host blocks go first: ssh takes the first value it finds per option.
    combined = "\n".join(part for part in (block.rstrip("\n"), unmanaged) if part)
    combined = combined + "\n" if combined else ""
    if combined == existing:
        return
    SSH_CONFIG.parent.mkdir(parents=True, exist_ok=True)
    SSH_CONFIG.parent.chmod(0o700)
    temp = SSH_CONFIG.with_suffix(".tmp")
    temp.write_text(combined)
    temp.chmod(0o600)
    temp.replace(SSH_CONFIG)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
