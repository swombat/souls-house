#!/usr/bin/env python3
"""Record a review, or turn on auto-merge, for a souls.house pull request.

Every contributor pushes as the same GitHub user, so GitHub's own Approve is
impossible. A review is a commit status instead: each reviewer sets
`review/<who>` on the exact head they read, and this script then derives the
`review` status from all of them. `review` fails if anyone has blocked that
head, succeeds once two different reviewers have approved it, and is pending
otherwise. The "Protect Main" ruleset requires `CI result` and `review`, and
auto-merge then squashes the PR in. A block holds until a new head is pushed
or the same reviewer approves that head.

    scripts/review-status <pr> <sha> approve "Mira: read the whole diff"
    scripts/review-status <pr> <sha> block "Mira: the lock is taken too late"
    scripts/review-status <pr> auto-merge

<sha> is the head you reviewed (seven characters or more). The script reads the
PR's current head and refuses if they differ, so a push you haven't read can't
be approved by mistake.

The token comes from GITHUB_TOKEN or GH_TOKEN, else from `git credential fill`.
"""
import json
import os
import subprocess
import sys
import urllib.error
import urllib.request

REPO = os.environ.get("REVIEW_STATUS_REPO", "swombat/souls-house")
API = "https://api.github.com"
CONTEXT = "review"
STATES = {"approve": "success", "block": "failure"}
REQUIRED_APPROVALS = 2
MIN_SHA = 7
MAX_DESCRIPTION = 140


class Refused(Exception):
    pass


def token():
    for name in ("GITHUB_TOKEN", "GH_TOKEN"):
        if os.environ.get(name):
            return os.environ[name]
    filled = subprocess.run(
        ["git", "credential", "fill"],
        input="protocol=https\nhost=github.com\n\n",
        capture_output=True,
        text=True,
        check=False,
    ).stdout
    for line in filled.splitlines():
        if line.startswith("password="):
            return line.split("=", 1)[1]
    raise Refused("no GitHub token: set GITHUB_TOKEN or configure a git credential for github.com")


def request(method, url, auth, body=None):
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(url, data=data, method=method)
    req.add_header("Authorization", f"Bearer {auth}")
    req.add_header("Accept", "application/vnd.github+json")
    if data is not None:
        req.add_header("Content-Type", "application/json")
    try:
        with urllib.request.urlopen(req, timeout=30) as response:
            return json.loads(response.read() or b"null")
    except urllib.error.HTTPError as error:
        raise Refused(f"{method} {url} failed: {error.code} {error.read().decode(errors='replace')[:300]}")


def check_head(pull, reviewed_sha):
    if pull.get("state") != "open":
        raise Refused(f"PR #{pull['number']} is {pull.get('state')}, not open")
    head = pull["head"]["sha"]
    reviewed = reviewed_sha.lower()
    if len(reviewed) < MIN_SHA:
        raise Refused(f"give at least {MIN_SHA} characters of the head you reviewed")
    if not head.startswith(reviewed):
        raise Refused(f"PR #{pull['number']} head is now {head[:12]}, not {reviewed}: read the new head first")
    return head


def reviewer_slug(note):
    who = note.split(":", 1)[0].strip().lower()
    slug = "".join(ch if ch.isalnum() else "-" for ch in who).strip("-")
    if ":" not in note or not slug:
        raise Refused('say who is reviewing: "<who>: <why>"')
    return slug


def clip(text):
    text = " ".join(text.split())
    return text if len(text) <= MAX_DESCRIPTION else text[: MAX_DESCRIPTION - 1] + "…"


def status_body(verdict, note):
    if verdict not in STATES:
        raise Refused(f"verdict must be one of {', '.join(STATES)}")
    note = " ".join(note.split())
    context = f"{CONTEXT}/{reviewer_slug(note)}"
    return {"state": STATES[verdict], "context": context, "description": clip(note)}


def aggregate(statuses):
    """The required `review` status, from the latest status of each review/<who>."""
    reviews = {s["context"]: s for s in statuses if s["context"].startswith(CONTEXT + "/")}
    blocks = [s for s in reviews.values() if s["state"] in ("failure", "error")]
    approvals = sorted(c.split("/", 1)[1] for c, s in reviews.items() if s["state"] == "success")
    if blocks:
        return {"state": "failure", "context": CONTEXT, "description": clip("Blocked. " + " | ".join(s["description"] or s["context"] for s in blocks))}
    if len(approvals) >= REQUIRED_APPROVALS:
        return {"state": "success", "context": CONTEXT, "description": clip(f"Approved by {', '.join(approvals)}")}
    so_far = f": {', '.join(approvals)}" if approvals else ""
    return {"state": "pending", "context": CONTEXT, "description": clip(f"{len(approvals)} of {REQUIRED_APPROVALS} approvals{so_far}")}


def latest_statuses(head, auth):
    # The combined endpoint returns the newest status for each context.
    return request("GET", f"{API}/repos/{REPO}/commits/{head}/status?per_page=100", auth)["statuses"]


def review(number, reviewed_sha, verdict, note, auth):
    body = status_body(verdict, note)
    pull = request("GET", f"{API}/repos/{REPO}/pulls/{number}", auth)
    head = check_head(pull, reviewed_sha)
    request("POST", f"{API}/repos/{REPO}/statuses/{head}", auth, body)
    summary = aggregate(latest_statuses(head, auth))
    request("POST", f"{API}/repos/{REPO}/statuses/{head}", auth, summary)
    # Two reviewers may run this at once. Read again after writing, so the last
    # word reflects every review/<who> that had landed by then.
    settled = aggregate(latest_statuses(head, auth))
    if settled != summary:
        request("POST", f"{API}/repos/{REPO}/statuses/{head}", auth, settled)
        summary = settled
    print(f"#{number} {head[:12]}: {body['context']} {body['state']}; review {summary['state']} ({summary['description']})")


def auto_merge(number, auth):
    pull = request("GET", f"{API}/repos/{REPO}/pulls/{number}", auth)
    if pull.get("state") != "open":
        raise Refused(f"PR #{number} is {pull.get('state')}, not open")
    mutation = (
        "mutation($id: ID!) { enablePullRequestAutoMerge(input: {pullRequestId: $id, mergeMethod: SQUASH})"
        " { pullRequest { number autoMergeRequest { mergeMethod } } } }"
    )
    result = request("POST", f"{API}/graphql", auth, {"query": mutation, "variables": {"id": pull["node_id"]}})
    if result.get("errors"):
        raise Refused(f"auto-merge not enabled on #{number}: {result['errors'][0].get('message')}")
    print(f"#{number}: auto-merge (squash) on; it merges when CI result and review are green on the head")


def main(argv):
    try:
        if len(argv) == 2 and argv[1] == "auto-merge":
            auto_merge(int(argv[0]), token())
        elif len(argv) == 4:
            review(int(argv[0]), argv[1], argv[2], argv[3], token())
        else:
            print(__doc__.strip(), file=sys.stderr)
            return 2
    except Refused as refusal:
        print(f"review-status: {refusal}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
